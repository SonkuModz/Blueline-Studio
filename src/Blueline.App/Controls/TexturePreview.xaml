<UserControl x:Class="Blueline.App.Controls.TexturePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
      <ToggleButton x:Name="ChanR" Content="R" Style="{StaticResource Chip}" IsChecked="True" Margin="0,0,3,0" Click="OnChannel" />
      <ToggleButton x:Name="ChanG" Content="G" Style="{StaticResource Chip}" IsChecked="True" Margin="0,0,3,0" Click="OnChannel" />
      <ToggleButton x:Name="ChanB" Content="B" Style="{StaticResource Chip}" IsChecked="True" Margin="0,0,3,0" Click="OnChannel" />
      <ToggleButton x:Name="ChanA" Content="A" Style="{StaticResource Chip}" Margin="0,0,12,0" Click="OnChannel" ToolTip="Blend with alpha" />
      <TextBlock Style="{StaticResource Dim}" Text="Mip" VerticalAlignment="Center" Margin="0,0,5,0" />
      <ComboBox x:Name="MipBox" Width="118" SelectionChanged="OnMipChanged" Margin="0,0,12,0" />
      <TextBlock x:Name="FaceLabel" Style="{StaticResource Dim}" Text="Face" VerticalAlignment="Center" Margin="0,0,5,0" />
      <ComboBox x:Name="FaceBox" Width="60" SelectionChanged="OnMipChanged" Margin="0,0,12,0" />
      <Button Content="Fit" Style="{StaticResource Quiet}" Padding="8,3" Click="OnFit" />
      <Button Content="1:1" Style="{StaticResource Quiet}" Padding="8,3" Click="OnActual" />
      <TextBlock x:Name="ZoomText" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="6,0,0,0" />
    </WrapPanel>

    <Border Grid.Row="1" CornerRadius="6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True">
      <Border.Background>
        <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
          <DrawingBrush.Drawing>
            <DrawingGroup>
              <GeometryDrawing Brush="#191D26" Geometry="M0,0 H2 V2 H0 Z" />
              <GeometryDrawing Brush="#222834" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
            </DrawingGroup>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </Border.Background>
      <Grid>
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="OnWheel" SizeChanged="OnViewportChanged">
          <Image x:Name="Picture" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
        </ScrollViewer>
        <TextBlock x:Name="Message" Style="{StaticResource Dim}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="30" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
