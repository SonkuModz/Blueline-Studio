<UserControl x:Class="Blueline.App.Controls.ModelViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border CornerRadius="6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True" Background="#10141C">
    <Grid x:Name="Surface" Background="Transparent" MouseDown="OnMouseDown" MouseUp="OnMouseUp" MouseMove="OnMouseMove" MouseWheel="OnWheel">
      <Viewport3D x:Name="View" ClipToBounds="True" IsHitTestVisible="False">
        <Viewport3D.Camera>
          <PerspectiveCamera x:Name="Camera" FieldOfView="40" NearPlaneDistance="0.01" FarPlaneDistance="100000" />
        </Viewport3D.Camera>
        <ModelVisual3D>
          <ModelVisual3D.Content>
            <Model3DGroup>
              <AmbientLight Color="#555B66" />
              <DirectionalLight Color="#E8ECF2" Direction="-0.4,-0.7,-0.6" />
              <DirectionalLight Color="#5A6A88" Direction="0.6,0.3,0.7" />
            </Model3DGroup>
          </ModelVisual3D.Content>
        </ModelVisual3D>
        <ModelVisual3D x:Name="Holder" />
      </Viewport3D>
      <TextBlock x:Name="Message" Style="{StaticResource Dim}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="30" />
      <TextBlock x:Name="Hint" Style="{StaticResource Dim}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8" Text="Drag to orbit  ·  Wheel to zoom  ·  Right-drag to pan" Visibility="Collapsed" />
    </Grid>
  </Border>
</UserControl>
