<UserControl x:Class="Blueline.App.Controls.AssetBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Blueline.App.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,8">
      <ComboBox x:Name="TypeFilter" DockPanel.Dock="Right" Width="124" Margin="6,0,0,0" SelectionChanged="OnFilterChanged" />
      <Grid>
        <TextBox x:Name="Search" TextChanged="OnSearchChanged" />
        <TextBlock x:Name="SearchHint" Text="Search paths" Style="{StaticResource Dim}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
      </Grid>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="TreeColumn" Width="210" MinWidth="100" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="200" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="4">
        <TreeView x:Name="Tree" SelectedItemChanged="OnFolderSelected">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding Name}" FontSize="12" />
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>
      <GridSplitter Grid.Column="1" />
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <ListView x:Name="List" SelectionMode="Extended" SelectionChanged="OnSelectionChanged" FontSize="12">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="" Width="18">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding EditedMark}" Foreground="{DynamicResource AccentBrush}" ToolTip="Changed in this project" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn x:Name="NameColumn" Header="NAME" Width="270" DisplayMemberBinding="{Binding Name}" />
              <GridViewColumn Header="SIZE" Width="72" DisplayMemberBinding="{Binding SizeText}" />
              <GridViewColumn Header="ARCHIVE" Width="130" DisplayMemberBinding="{Binding Source}" />
            </GridView>
          </ListView.View>
        </ListView>
      </Border>
    </Grid>

    <TextBlock x:Name="Count" Grid.Row="2" Style="{StaticResource Dim}" Margin="2,6,0,0" />
  </Grid>
</UserControl>
