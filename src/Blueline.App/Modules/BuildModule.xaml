<UserControl x:Class="Blueline.App.Modules.BuildModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="380" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Margin="2,0,0,8" Grid.ColumnSpan="3">
      <Button DockPanel.Dock="Right" x:Name="RevertSelected" Content="Revert selected" Click="OnRevert" />
      <TextBlock x:Name="Heading" Style="{StaticResource Heading}" FontSize="16" VerticalAlignment="Center" />
    </DockPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
      <Grid>
        <ListView x:Name="Changes" SelectionMode="Extended" FontSize="12" MouseDoubleClick="OnOpenChange" SelectionChanged="OnChangeSelected">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="PATH" Width="510" DisplayMemberBinding="{Binding Path}" />
              <GridViewColumn Header="CHANGE" Width="210" DisplayMemberBinding="{Binding Description}" />
              <GridViewColumn Header="SIZE" Width="80" DisplayMemberBinding="{Binding SizeText}" />
              <GridViewColumn Header="INSTALLS TO" Width="100" DisplayMemberBinding="{Binding Layer}" />
            </GridView>
          </ListView.View>
        </ListView>
        <ListView x:Name="MergeRows" FontSize="12" Visibility="Collapsed" SelectionMode="Single">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="ADD" Width="50">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Take, Mode=TwoWay}" IsEnabled="{Binding CanTake}" Click="OnMergeRowTicked" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="PATH" Width="520" DisplayMemberBinding="{Binding Path}" />
              <GridViewColumn Header="WHAT IT DOES" Width="250" DisplayMemberBinding="{Binding Effect}" />
              <GridViewColumn Header="SIZE" Width="80" DisplayMemberBinding="{Binding SizeText}" />
            </GridView>
          </ListView.View>
        </ListView>
        <StackPanel x:Name="EmptyChanges" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
          <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
          <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock x:Name="EmptyText" Style="{StaticResource Dim}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="ADD ANOTHER MOD" />
            <StackPanel x:Name="MergeStart">
              <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8" Text="Combines another mod into this project. You see every file first, and the other mod is not changed." />
              <WrapPanel>
                <Button x:Name="AddFolderButton" Content="Project or folder" Margin="0,0,6,4" Click="OnAddFolder" ToolTip="A Blueline project, or a folder of .big archives" />
                <Button x:Name="AddArchiveButton" Content=".big file" Margin="0,0,0,4" Click="OnAddArchive" ToolTip="A built mod archive" />
              </WrapPanel>
            </StackPanel>
            <StackPanel x:Name="MergeReview" Visibility="Collapsed">
              <TextBlock x:Name="MergeTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="MergeSummary" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0" />
              <ItemsControl x:Name="MergeWarnings" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel x:Name="ConflictChoice" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Use theirs on conflicts" Style="{StaticResource Quiet}" FontSize="12" Margin="0,0,8,0" Click="OnUseTheirs" />
                <Button Content="Keep mine" Style="{StaticResource Quiet}" FontSize="12" Click="OnKeepMine" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="MergeButton" Style="{StaticResource Primary}" Margin="0,0,6,0" Click="OnMerge" />
                <Button Content="Cancel" Click="OnCancelMerge" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="BUILD" />
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8" Text="Writes overlay archives into the project folder, then reads every file back to check it." />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BuildButton" Content="Build" Style="{StaticResource Primary}" Margin="0,0,6,0" Click="OnBuild" />
              <Button x:Name="OpenFolder" Content="Open folder" Click="OnOpenFolder" />
            </StackPanel>
            <TextBlock x:Name="BuildResultText" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
            <ItemsControl x:Name="Warnings" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="INSTALL" />
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8" Text="Copies the built archives into databigs. No original archive changes. Uninstalling deletes only what was installed here." />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="InstallButton" Content="Install" Style="{StaticResource Primary}" Margin="0,0,6,0" Click="OnInstall" />
              <Button x:Name="UninstallButton" Content="Uninstall" Click="OnUninstall" />
            </StackPanel>
            <TextBlock x:Name="InstallState" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="MODS IN THIS INSTALL" />
            <ItemsControl x:Name="Installed" FontSize="12" />
            <TextBlock x:Name="NoneInstalled" Style="{StaticResource Dim}" Text="None" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
