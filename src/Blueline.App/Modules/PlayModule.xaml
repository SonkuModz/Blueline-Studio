<UserControl x:Class="Blueline.App.Modules.PlayModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="400" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Game -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border CornerRadius="6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Height="225" ClipToBounds="True" Background="{DynamicResource PanelBrush}">
          <Grid>
            <Image x:Name="Art" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock x:Name="NoArt" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No game loaded" />
          </Grid>
        </Border>

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="PlayButton" Style="{StaticResource Primary}" Content="Play" FontSize="16" FontWeight="SemiBold" Height="44" Click="OnPlay" />
          <Button x:Name="StopButton" Grid.Column="1" Content="Stop game" Height="44" Margin="8,0,0,0" Padding="16,0" Visibility="Collapsed" Click="OnStop" />
        </Grid>
        <TextBlock x:Name="StateText" TextWrapping="Wrap" Margin="2,8,2,10" FontSize="12" />

        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="GAME" />
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="FactsText" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,3,0,0" />
            <TextBlock x:Name="FolderText" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="11" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="MODS IN THIS INSTALL" />
            <TextBlock x:Name="ModsText" TextWrapping="Wrap" FontSize="12" />
            <TextBlock x:Name="ProjectNote" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <Button Content="Open Build" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnOpenBuild" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="KEYBOARD CONTROLS" />
            <TextBlock x:Name="ControlsText" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,6,0,0" Text="The game window has to be in front to take input. These come from the emulator's default.ini." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Emulator -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="170" />
      </Grid.RowDefinitions>

      <Border Style="{StaticResource Card}" Margin="0,0,0,8">
        <DockPanel>
          <Button DockPanel.Dock="Right" x:Name="ChooseEmulator" Content="Choose shadPS4.exe" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnChooseEmulator" />
          <Button DockPanel.Dock="Right" x:Name="OpenFolder" Content="Open settings folder" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnOpenFolder" />
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="SHADPS4" />
            <TextBlock x:Name="EmulatorText" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ConfigText" Style="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="SettingsMessage" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="4,12" Visibility="Collapsed" />
          <Border x:Name="ScopeCard" Style="{StaticResource Card}" Margin="0,0,0,8" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Style="{StaticResource Section}" Text="EDITING" />
              <ComboBox x:Name="ScopeBox" DisplayMemberPath="Label" SelectionChanged="OnScopeChanged" MaxWidth="420" HorizontalAlignment="Left" MinWidth="320" />
              <TextBlock x:Name="ScopeNote" Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <StackPanel x:Name="Groups" />
        </StackPanel>
      </ScrollViewer>

      <DockPanel Grid.Row="2" Margin="0,8,0,8">
        <Button DockPanel.Dock="Right" x:Name="SaveButton" Style="{StaticResource Primary}" Content="Save settings" Margin="6,0,0,0" Click="OnSave" />
        <Button DockPanel.Dock="Right" x:Name="DiscardButton" Content="Discard changes" Margin="6,0,0,0" Click="OnDiscard" />
        <Button DockPanel.Dock="Right" x:Name="RestoreButton" Content="Restore original file" Margin="6,0,0,0" Click="OnRestore" />
        <TextBlock x:Name="SaveState" Style="{StaticResource Dim}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>

      <Border Grid.Row="3" Style="{StaticResource Card}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" x:Name="OpenLog" Content="Open full log" Style="{StaticResource Quiet}" Click="OnOpenLog" />
            <TextBlock Style="{StaticResource Section}" Text="EMULATOR LOG" VerticalAlignment="Center" Margin="0" />
          </DockPanel>
          <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="Nothing yet. The log appears here once the game starts." />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
