<UserControl x:Class="Blueline.App.Modules.AssetsModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Blueline.App.Controls">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="460" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="*" MinWidth="380" />
    </Grid.ColumnDefinitions>

    <controls:AssetBrowser x:Name="Browser" />
    <GridSplitter Grid.Column="1" />

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Style="{StaticResource Card}" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock x:Name="NameText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="No file selected" />
          <TextBlock x:Name="PathText" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,6" />
          <TextBlock x:Name="FactsText" FontSize="12" TextWrapping="Wrap" />
          <TextBlock x:Name="LayersText" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0" />
          <WrapPanel Margin="0,10,0,0">
            <Button x:Name="ExportButton" Content="Export" Margin="0,0,6,0" Click="OnExport" ToolTip="Save the selected files, keeping their game folders" />
            <Button x:Name="ReplaceButton" Content="Replace" Margin="0,0,6,0" Click="OnReplace" ToolTip="Use a file from disk for this path in the project. You can also drop a file here." />
            <Button x:Name="RevertButton" Content="Revert" Margin="0,0,6,0" Click="OnRevert" ToolTip="Remove this file from the project" />
            <Button x:Name="OpenInButton" Margin="0,0,6,0" Click="OnOpenIn" Visibility="Collapsed" />
            <Button x:Name="SaveTextButton" Content="Save text" Style="{StaticResource Primary}" Click="OnSaveText" Visibility="Collapsed" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border x:Name="PreviewCard" Grid.Row="1" Style="{StaticResource Card}">
        <Grid>
          <controls:TexturePreview x:Name="Texture" Visibility="Collapsed" />
          <controls:VideoPlayer x:Name="Video" Visibility="Collapsed" />
          <controls:FontPreview x:Name="FontView" Visibility="Collapsed" />
          <TextBox x:Name="TextView" Visibility="Collapsed" AcceptsReturn="True" AcceptsTab="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                   VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextChanged="OnTextEdited" />
          <TextBox x:Name="HexView" Visibility="Collapsed" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                   VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
          <TextBlock x:Name="Placeholder" Style="{StaticResource Dim}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="30"
                     Text="Select a file to preview it." />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
