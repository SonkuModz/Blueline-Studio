<UserControl x:Class="Blueline.App.Modules.AudioModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Blueline.App.Controls">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="500" MinWidth="360" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="*" MinWidth="360" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="260" />
    </Grid.ColumnDefinitions>

    <controls:AssetBrowser x:Name="Browser" />
    <GridSplitter Grid.Column="1" />

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="BankText" FontWeight="SemiBold" FontSize="14" Margin="2,4,0,8" TextTrimming="CharacterEllipsis" Text="Select a sound bank" />
      <Border x:Name="SamplesCard" Grid.Row="1" Style="{StaticResource Card}" Padding="0">
        <ListView x:Name="Samples" SelectionMode="Extended" FontSize="12" SelectionChanged="OnSampleSelected">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="#" Width="52" DisplayMemberBinding="{Binding Index}" />
              <GridViewColumn Header="CODEC" Width="80" DisplayMemberBinding="{Binding CodecName}" />
              <GridViewColumn Header="RATE" Width="64" DisplayMemberBinding="{Binding SampleRate}" />
              <GridViewColumn Header="LENGTH" Width="70" DisplayMemberBinding="{Binding Seconds, StringFormat={}{0:F2}s}" />
              <GridViewColumn Header="BYTES" Width="86" DisplayMemberBinding="{Binding Length, StringFormat={}{0:N0}}" />
              <GridViewColumn Header="OFFSET" Width="100" DisplayMemberBinding="{Binding Offset, StringFormat={}0x{0:X}}" />
            </GridView>
          </ListView.View>
        </ListView>
      </Border>
      <TextBlock x:Name="Count" Grid.Row="2" Style="{StaticResource Dim}" Margin="2,6,0,0" TextWrapping="Wrap" />
    </Grid>

    <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="LISTEN AND EXPORT" />
            <Button x:Name="Play" Content="Play sample" Style="{StaticResource Primary}" Margin="0,0,0,6" Click="OnPlay" />
            <Button x:Name="Stop" Content="Stop" Margin="0,0,0,6" Click="OnStop" IsEnabled="False" />
            <Button x:Name="Export" Content="Export WAV" Click="OnExport" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="REPLACE" />
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Drop a WAV on the sample list, or choose one. It is encoded in this sample's codec at the best quality that fits its slot. A slot cannot grow, because how the game seeks in a bank is not established." />
            <Button x:Name="Replace" Content="Replace from WAV" Margin="0,0,0,6" Click="OnReplace" />
            <Button x:Name="RevertBank" Content="Revert bank" Click="OnRevert" />
          </StackPanel>
        </Border>
        <TextBlock x:Name="ToolNote" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
