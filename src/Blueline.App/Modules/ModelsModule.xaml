<UserControl x:Class="Blueline.App.Modules.ModelsModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Blueline.App.Controls">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="500" MinWidth="360" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="*" MinWidth="360" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="280" />
    </Grid.ColumnDefinitions>

    <controls:AssetBrowser x:Name="Browser" />
    <GridSplitter Grid.Column="1" />
    <controls:ModelViewport x:Name="Viewport" Grid.Column="2" />

    <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="MODEL" />
            <TextBlock x:Name="NameText" FontWeight="SemiBold" TextWrapping="Wrap" Text="None selected" />
            <TextBlock x:Name="FactsText" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <Button x:Name="ExportObj" Content="Export OBJ" Margin="0,10,0,6" Click="OnExportObj" />
            <Button x:Name="ExportSelected" Content="Export selected as OBJ" Click="OnExportSelected" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="SHAPES" />
            <ListBox x:Name="Shapes" FontSize="12" MaxHeight="340" SelectionMode="Multiple" />
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,8" Text="Select shapes to hide them in the preview." />
            <Button x:Name="ApplyHide" Content="Update preview" Click="OnApplyHide" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="LIMITS" />
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Text="Models are read-only here. Writing changed geometry back has not been tested in game, so this build does not offer it. A model file holds no material or texture data, so previews are grey." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
