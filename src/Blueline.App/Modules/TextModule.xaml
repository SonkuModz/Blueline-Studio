<UserControl x:Class="Blueline.App.Modules.TextModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="460" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="400" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
      <ComboBox x:Name="LanguageBox" DockPanel.Dock="Left" Width="150" Margin="0,0,8,0" SelectionChanged="OnLanguageChanged" />
      <Button DockPanel.Dock="Right" Content="Import CSV" Margin="6,0,0,0" Click="OnImportCsv" ToolTip="Apply a CSV with key and text columns" />
      <Button DockPanel.Dock="Right" Content="Export CSV" Margin="6,0,0,0" Click="OnExportCsv" />
      <ToggleButton DockPanel.Dock="Right" x:Name="OnlyEdited" Content="Edited only" Style="{StaticResource Chip}" Margin="6,0,0,0" Click="OnFilterClicked" />
      <Grid>
        <TextBox x:Name="Search" TextChanged="OnSearchChanged" />
        <TextBlock x:Name="SearchHint" Text="Search keys and text" Style="{StaticResource Dim}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
      </Grid>
    </DockPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
      <ListView x:Name="Rows" SelectionMode="Single" SelectionChanged="OnRowSelected" FontSize="12">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="" Width="18">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Mark}" Foreground="{DynamicResource AccentBrush}" /></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="KEY" Width="300" DisplayMemberBinding="{Binding Key}" />
            <GridViewColumn Header="TEXT" Width="560" DisplayMemberBinding="{Binding OneLine}" />
          </GridView>
        </ListView.View>
      </ListView>
    </Border>
    <TextBlock x:Name="Count" Grid.Row="2" Style="{StaticResource Dim}" Margin="2,6,0,0" />

    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="STRING" />
            <TextBlock x:Name="KeyText" FontWeight="SemiBold" TextWrapping="Wrap" Text="None selected" />
            <TextBlock Style="{StaticResource Section}" Text="ORIGINAL" Margin="0,12,0,4" />
            <TextBlock x:Name="OriginalText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DimBrush}" />
            <TextBlock Style="{StaticResource Section}" Text="TEXT" Margin="0,12,0,4" />
            <TextBox x:Name="EditBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" VerticalContentAlignment="Top" TextChanged="OnEditChanged" IsEnabled="False" />
            <TextBlock x:Name="Problem" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="Apply" Content="Save to project" Style="{StaticResource Primary}" Margin="0,0,6,0" IsEnabled="False" Click="OnApply" />
              <Button x:Name="UseOriginal" Content="Use original" IsEnabled="False" Click="OnUseOriginal" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="ADD STRING" />
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8" Text="Only useful where a mod's UI asks for this key. The game does not look up keys it does not know." />
            <TextBlock Style="{StaticResource Dim}" Text="Key" Margin="0,0,0,3" />
            <TextBox x:Name="NewKey" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource Dim}" Text="Text" Margin="0,0,0,3" />
            <TextBox x:Name="NewText" Margin="0,0,0,8" />
            <Button Content="Add string" HorizontalAlignment="Left" Click="OnAdd" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
