<UserControl x:Class="Blueline.App.Modules.JerseyMapsModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Blueline.App.Controls">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="420" MinWidth="320" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="*" MinWidth="360" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="292" />
    </Grid.ColumnDefinitions>

    <controls:AssetBrowser x:Name="Browser" />
    <GridSplitter Grid.Column="1" />

    <DockPanel Grid.Column="2">
      <WrapPanel x:Name="Views" DockPanel.Dock="Top" Margin="2,0,0,6">
        <ToggleButton x:Name="ViewColour" Style="{StaticResource Chip}" Content="Colour sheet" Margin="0,0,4,4" Click="OnView" Tag="Colour" />
        <ToggleButton x:Name="ViewRaised" Style="{StaticResource Chip}" Content="Raised areas" Margin="0,0,10,4" Click="OnView" Tag="Raised"
                      ToolTip="White is pressed into the normal map and marked in the coeff map" />
        <ToggleButton x:Name="ViewNormal" Style="{StaticResource Chip}" Content="New normal" Margin="0,0,4,4" Click="OnView" Tag="Normal" IsChecked="True" />
        <ToggleButton x:Name="ViewCoeff" Style="{StaticResource Chip}" Content="New coeff" Margin="0,0,10,4" Click="OnView" Tag="Coeff" />
        <ToggleButton x:Name="ViewGameNormal" Style="{StaticResource Chip}" Content="Current normal" Margin="0,0,4,4" Click="OnView" Tag="GameNormal" />
        <ToggleButton x:Name="ViewGameCoeff" Style="{StaticResource Chip}" Content="Current coeff" Margin="0,0,0,4" Click="OnView" Tag="GameCoeff" />
      </WrapPanel>
      <TextBlock x:Name="ViewNote" DockPanel.Dock="Bottom" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="2,6,0,0" />
      <Border x:Name="PreviewCard" Style="{StaticResource Card}" Padding="6">
        <controls:TexturePreview x:Name="Preview" />
      </Border>
    </DockPanel>

    <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="JERSEY" />
            <TextBlock x:Name="NameText" FontWeight="SemiBold" TextWrapping="Wrap" Text="None selected" />
            <TextBlock x:Name="KitText" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock x:Name="StateText" Foreground="{DynamicResource AccentBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="RAISED AREAS" />
            <WrapPanel Margin="0,0,0,8">
              <ToggleButton x:Name="FromColourChip" Style="{StaticResource Chip}" Content="From the colours" Margin="0,0,4,0" IsChecked="True" Click="OnSourceChip"
                            ToolTip="Everything that is not the jersey's main colour" />
              <ToggleButton x:Name="FromPictureChip" Style="{StaticResource Chip}" Content="From a picture" Click="OnSourceChip"
                            ToolTip="A picture the size of the sheet: transparency, or else brightness, marks what is raised" />
            </WrapPanel>
            <StackPanel x:Name="ColourOptions">
              <DockPanel Margin="0,0,0,4">
                <Border x:Name="MainSwatch" DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" />
                <TextBlock x:Name="MainText" Style="{StaticResource Dim}" Text="Main colour" VerticalAlignment="Center" />
              </DockPanel>
              <DockPanel>
                <TextBlock x:Name="ToleranceValue" DockPanel.Dock="Right" Style="{StaticResource Dim}" Width="34" TextAlignment="Right" />
                <TextBlock Style="{StaticResource Dim}" Text="Tolerance" />
              </DockPanel>
              <Slider x:Name="ToleranceSlider" Minimum="5" Maximum="120" Value="40" SmallChange="1" LargeChange="10" ValueChanged="OnOption"
                      ToolTip="How different from the main colour a colour must be to count as raised" />
            </StackPanel>
            <StackPanel x:Name="PictureOptions" Visibility="Collapsed">
              <Button Content="Choose picture" Margin="0,0,0,4" Click="OnChoosePicture" />
              <TextBlock x:Name="PictureText" Style="{StaticResource Dim}" TextWrapping="Wrap" Text="No picture chosen. Drop one on the preview, or choose one." />
            </StackPanel>
            <DockPanel Margin="0,8,0,0">
              <TextBlock x:Name="DetailValue" DockPanel.Dock="Right" Style="{StaticResource Dim}" Width="34" TextAlignment="Right" />
              <TextBlock Style="{StaticResource Dim}" Text="Inner detail" />
            </DockPanel>
            <Slider x:Name="DetailSlider" Minimum="0" Maximum="1" Value="0.4" SmallChange="0.05" LargeChange="0.1" ValueChanged="OnOption"
                    ToolTip="How much brightness changes inside a raised area show, like the letters in a crest" />
            <DockPanel Margin="0,6,0,0">
              <TextBlock x:Name="ClearText" DockPanel.Dock="Right" Style="{StaticResource Dim}" Width="34" TextAlignment="Right" />
              <TextBlock Style="{StaticResource Dim}" Text="Clear old marks around it" />
            </DockPanel>
            <Slider x:Name="ClearSlider" Minimum="0" Maximum="48" Value="20" SmallChange="1" LargeChange="4" ValueChanged="OnOption"
                    ToolTip="Pixels around the design where the starting map is smoothed, so a logo already pressed into it, like the adidas mark, does not show behind yours. 0 keeps it as it is" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="NORMAL MAP (_nm)" />
            <TextBlock Style="{StaticResource Dim}" Text="Start from" Margin="0,0,0,3" />
            <ComboBox x:Name="NormalBaseBox" Margin="0,0,0,8" SelectionChanged="OnBaseChosen" />
            <DockPanel>
              <TextBlock x:Name="HeightValue" DockPanel.Dock="Right" Style="{StaticResource Dim}" Width="34" TextAlignment="Right" />
              <TextBlock Style="{StaticResource Dim}" Text="Depth" />
            </DockPanel>
            <Slider x:Name="HeightSlider" Minimum="0" Maximum="3" Value="1" SmallChange="0.05" LargeChange="0.25" ValueChanged="OnOption"
                    ToolTip="1 is about as deep as the game's own crests" />
            <DockPanel Margin="0,6,0,0">
              <TextBlock x:Name="SoftnessValue" DockPanel.Dock="Right" Style="{StaticResource Dim}" Width="34" TextAlignment="Right" />
              <TextBlock Style="{StaticResource Dim}" Text="Edge softness" />
            </DockPanel>
            <Slider x:Name="SoftnessSlider" Minimum="0" Maximum="6" Value="1" SmallChange="1" LargeChange="1" ValueChanged="OnOption"
                    ToolTip="How wide the bevel on each edge is, in pixels at 2048 wide. 0 is a hard step" />
            <DockPanel Margin="0,6,0,0">
              <TextBlock x:Name="GrainValue" DockPanel.Dock="Right" Style="{StaticResource Dim}" Width="34" TextAlignment="Right" />
              <TextBlock Style="{StaticResource Dim}" Text="Cloth grain" />
            </DockPanel>
            <Slider x:Name="GrainSlider" Minimum="0" Maximum="1" Value="0.25" SmallChange="0.05" LargeChange="0.1" ValueChanged="OnOption"
                    ToolTip="Fine texture inside the design, so it reads as sewn-on cloth rather than smooth plastic" />
            <CheckBox x:Name="StitchBox" Content="Stitched edge" IsChecked="True" Margin="0,8,0,0" Click="OnOptionClick"
                      ToolTip="A dashed line just outside the design, like the stitching around the game's crests" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="COEFF MAP (_coeff, the sm map)" />
            <TextBlock Style="{StaticResource Dim}" Text="Start from" Margin="0,0,0,3" />
            <ComboBox x:Name="CoeffBaseBox" Margin="0,0,0,8" SelectionChanged="OnBaseChosen" />
            <CheckBox x:Name="MarkCoeff" Content="Mark the raised areas" IsChecked="True" Margin="0,0,0,6" Click="OnOptionClick" />
            <DockPanel>
              <TextBlock x:Name="CoeffValue" DockPanel.Dock="Right" Style="{StaticResource Dim}" Width="34" TextAlignment="Right" />
              <TextBlock Style="{StaticResource Dim}" Text="Grey value" />
            </DockPanel>
            <Slider x:Name="CoeffSlider" Minimum="0" Maximum="255" Value="60" SmallChange="1" LargeChange="10" ValueChanged="OnOption"
                    ToolTip="All three channels in the raised areas. Plain fabric is about 16 to 27; the game's crests use 46 to 79" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="SAVE" />
            <TextBlock Style="{StaticResource Dim}" Text="Quality" Margin="0,0,0,3" />
            <ComboBox x:Name="QualityBox" Margin="0,0,0,8" />
            <Button x:Name="ApplyButton" Content="Use these maps" Style="{StaticResource Primary}" Margin="0,0,0,6" Click="OnApply"
                    ToolTip="Puts both maps in the project as one undo step, in the game's own size and format" />
            <Button x:Name="ExportButton" Content="Export PNGs" Margin="0,0,0,6" Click="OnExport" />
            <Button x:Name="RevertButton" Content="Revert maps" Click="OnRevert" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="LIMITS" />
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Text="Made like the game's own maps, measured on its sheets, but not yet seen in game. What each coeff channel does in the game's lighting is not known; raised areas get one grey, as the game's crests do. The plain bases are built from the game's own jerseys of that brand, so a mark every jersey of a brand shares, like the adidas logo, stays in them: clear it with the slider, or use a blank of your own." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
