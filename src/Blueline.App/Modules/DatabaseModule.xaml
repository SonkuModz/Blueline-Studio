<UserControl x:Class="Blueline.App.Modules.DatabaseModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ComboBox x:Name="DatabaseBox" Margin="0,0,0,8" SelectionChanged="OnDatabaseChanged" />
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
      <ListBox x:Name="Tables" FontSize="12" SelectionChanged="OnTableChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Dim}" />
              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <TextBlock x:Name="CrcText" Grid.Row="2" Style="{StaticResource Dim}" Margin="2,6,0,0" TextWrapping="Wrap" />

    <DockPanel Grid.Column="2" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" x:Name="Save" Content="Save to project" Style="{StaticResource Primary}" Margin="6,0,0,0" IsEnabled="False" Click="OnSave" />
      <Button DockPanel.Dock="Right" x:Name="Discard" Content="Discard" Margin="6,0,0,0" IsEnabled="False" Click="OnDiscard" />
      <Button DockPanel.Dock="Right" Content="Import CSV" Margin="6,0,0,0" Click="OnImport" />
      <Button DockPanel.Dock="Right" Content="Export CSV" Margin="6,0,0,0" Click="OnExport" />
      <Grid>
        <TextBox x:Name="Filter" TextChanged="OnFilterChanged" />
        <TextBlock x:Name="FilterHint" Text="Filter rows" Style="{StaticResource Dim}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
      </Grid>
    </DockPanel>
    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="0">
      <DataGrid x:Name="Grid" FontSize="12" CellEditEnding="OnCellEdit" SelectionUnit="Cell" />
    </Border>
    <TextBlock x:Name="StatusLine" Grid.Row="2" Grid.Column="2" Style="{StaticResource Dim}" Margin="2,6,0,0" TextWrapping="Wrap" />
  </Grid>
</UserControl>
