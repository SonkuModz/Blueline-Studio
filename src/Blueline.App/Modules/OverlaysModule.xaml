<UserControl x:Class="Blueline.App.Modules.OverlaysModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Blueline.App.Controls">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" MinWidth="220" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="*" MinWidth="600" />
    </Grid.ColumnDefinitions>

    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource Section}" Text="OVERLAYS" />
      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
        <TextBox x:Name="SearchBox" TextChanged="OnSearch" />
        <TextBlock x:Name="SearchHint" Style="{StaticResource Dim}" Text="Find an overlay" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
      </Grid>
      <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Style="{StaticResource Dim}" Margin="2,6,0,0" />
      <ListBox x:Name="OverlayList" SelectionChanged="OnOverlayChosen">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource Section}" Text="{Binding Name}" Margin="4,8,0,2" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2,1">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Style="{StaticResource Dim}" FontSize="11" Text="{Binding Summary}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <GridSplitter Grid.Column="1" />

    <DockPanel Grid.Column="2">
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
            <ToggleButton x:Name="LayoutChip" Style="{StaticResource Chip}" Content="Layout" Margin="0,0,4,0" Tag="Layout" Click="OnPage" />
            <ToggleButton x:Name="TexturesChip" Style="{StaticResource Chip}" Content="Textures" Margin="0,0,4,0" Tag="Textures" Click="OnPage" />
            <ToggleButton x:Name="SettingsChip" Style="{StaticResource Chip}" Content="Settings" Margin="0,0,4,0" Tag="Settings" Click="OnPage" />
            <ToggleButton x:Name="FilesChip" Style="{StaticResource Chip}" Content="Files" Tag="Files" Click="OnPage" />
          </WrapPanel>
          <StackPanel>
            <TextBlock x:Name="NameText" FontWeight="SemiBold" FontSize="15" Text="Select an overlay" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid>
        <!-- Layout -->
        <Grid x:Name="LayoutPage">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="340" MinWidth="260" />
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Style="{StaticResource Dim}" Text="Layout" VerticalAlignment="Center" Margin="0,0,6,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Dim}" Text="Zoom" VerticalAlignment="Center" Margin="10,0,6,0" />
                  <Slider x:Name="ZoomSlider" Width="130" Minimum="0.1" Maximum="3" Value="1" VerticalAlignment="Center" ValueChanged="OnZoom" />
                  <Button Content="Fit" Margin="6,0,0,0" Padding="10,2" Click="OnFit" />
                </StackPanel>
                <ComboBox x:Name="LayoutBox" SelectionChanged="OnLayoutChosen" />
              </DockPanel>
              <WrapPanel x:Name="PreviewBar" DockPanel.Dock="Top" Margin="0,0,0,6">
                <ComboBox x:Name="ViewBox" Width="120" Margin="0,0,10,0" SelectedIndex="0" SelectionChanged="OnViewChosen">
                  <ComboBoxItem Content="Game screen" />
                  <ComboBoxItem Content="Close up" />
                </ComboBox>
                <TextBlock Style="{StaticResource Dim}" Text="Away" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="AwayBox" Width="170" Margin="0,0,10,0" SelectionChanged="OnTeamChosen" />
                <TextBlock Style="{StaticResource Dim}" Text="Home" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="HomeBox" Width="170" Margin="0,0,10,0" SelectionChanged="OnTeamChosen" />
                <CheckBox x:Name="ShowHiddenBox" Content="Show parts the game brings up during play" VerticalAlignment="Center" Margin="0,0,10,0" Click="OnShowHidden" />
                <StackPanel x:Name="MomentPanel" Orientation="Horizontal" Visibility="Collapsed">
                  <TextBlock Style="{StaticResource Dim}" Text="Game moment" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <ComboBox x:Name="MomentBox" Width="240" SelectionChanged="OnMomentChosen" />
                  <Button x:Name="FlatButton" Content="Flat look" Margin="10,0,0,0" Padding="10,2" Click="OnFlatLook"
                          ToolTip="Takes the shading out of the score clock by replacing its shading textures. Nothing moves. Restore shading puts the originals back." />
                  <Button x:Name="UnflatButton" Content="Restore shading" Margin="6,0,0,0" Padding="10,2" Click="OnRestoreShading" />
                  <Button x:Name="SportsnetButton" Content="Sportsnet look" Margin="10,0,0,0" Padding="10,2" Click="OnSportsnetLook"
                          ToolTip="Restyles this score clock to the Sportsnet bug's proportions and colours. One undo step, and Revert layout restores the original." />
                </StackPanel>
              </WrapPanel>
              <DockPanel x:Name="MovieBar" DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="Collapsed">
                <Button x:Name="MoviePlay" DockPanel.Dock="Left" Content="Play" Padding="12,2" Margin="0,0,8,0" Click="OnMoviePlay" />
                <TextBlock x:Name="MovieFrameText" DockPanel.Dock="Right" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0" />
                <Slider x:Name="MovieSlider" Minimum="0" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="OnMovieFrame" />
              </DockPanel>
              <TextBlock x:Name="PreviewNote" DockPanel.Dock="Bottom" Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
              <Border x:Name="CanvasFrame" Background="#FF262C34" ClipToBounds="True">
                <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:OverlayCanvas x:Name="Canvas" />
                  </Grid>
                </ScrollViewer>
              </Border>
            </DockPanel>
          </Border>
          <TextBlock x:Name="NoLayoutText" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Visibility="Collapsed"
                     Text="This overlay has no layout file. Its art is on the Textures page." />
          <GridSplitter Grid.Column="1" />

          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="2*" />
              <RowDefinition Height="8" />
              <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="8">
              <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                  <Button x:Name="CopyWidget" Content="Copy" Padding="12,2" Margin="0,0,4,0" Click="OnCopyWidget" />
                  <Button x:Name="DeleteWidget" Content="Delete" Padding="12,2" Margin="0,0,4,0" Click="OnDeleteWidget" />
                  <Button x:Name="RevertLayout" Content="Revert layout" Padding="12,2" Click="OnRevertLayout" />
                </StackPanel>
                <TextBlock x:Name="MovieHint" DockPanel.Dock="Top" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="4" Visibility="Collapsed"
                           Text="Movies have no widgets to edit here. Change their pictures on the Textures page, or export and replace the movie on the Files page." />
                <TreeView x:Name="WidgetTree" SelectedItemChanged="OnTreeChosen">
                  <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                  </TreeView.ItemContainerStyle>
                  <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                      <TextBlock Text="{Binding Label}" />
                    </HierarchicalDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </DockPanel>
            </Border>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
              <DockPanel>
                <TextBlock x:Name="WidgetTitle" DockPanel.Dock="Top" Style="{StaticResource Section}" Text="PROPERTIES" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <controls:JsonPropertyEditor x:Name="WidgetEditor" Margin="0,0,6,0" />
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- Textures -->
        <Grid x:Name="TexturesPage" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="230" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="6">
            <ListBox x:Name="ArtList" BorderThickness="0" Background="Transparent" SelectionChanged="OnArtChosen"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Width="112" Margin="2" ToolTip="{Binding Path}">
                    <Border Height="92" Background="#FF262C34">
                      <Image Source="{Binding Thumb.Image}" Stretch="Uniform" Margin="4" />
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                    <TextBlock Style="{StaticResource Dim}" FontSize="10" Text="{Binding State}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <GridSplitter Grid.Column="1" />
          <Border x:Name="ArtCard" Grid.Column="2" Style="{StaticResource Card}">
            <controls:TexturePreview x:Name="ArtPreview" />
          </Border>
          <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Section}" Text="TEXTURE" />
                <TextBlock x:Name="ArtName" FontWeight="SemiBold" TextWrapping="Wrap" Text="None selected" />
                <TextBlock x:Name="ArtFacts" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,8" />
                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Drop an image on the preview, or choose one. It is fitted to this texture's size and format." />
                <Button x:Name="ArtImport" Content="Import image" Style="{StaticResource Primary}" Margin="0,0,0,6" Click="OnArtImport" />
                <Button x:Name="ArtExport" Content="Export PNG" Margin="0,0,0,6" Click="OnArtExport" />
                <Button x:Name="ArtRevert" Content="Revert to original" Margin="0,0,0,6" Click="OnArtRevert" />
                <Button x:Name="ArtOpen" Content="Open in Textures" Click="OnArtOpen" />
                <TextBlock x:Name="ArtBlocker" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
              </StackPanel>
            </Border>
          </ScrollViewer>
          <TextBlock x:Name="NoArtText" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Text="This overlay has no textures of its own." />
        </Grid>

        <!-- Settings -->
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="280" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="10">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource Section}" Text="DEFINITION" />
              <ComboBox x:Name="DefinitionBox" DockPanel.Dock="Top" Margin="0,0,0,8" SelectionChanged="OnDefinitionChosen" />
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8"
                         Text="lifetime is in seconds, and -1 stays until the game hides it. showAction and hideAction are the events that trigger it." />
              <Button x:Name="RevertDefinitions" DockPanel.Dock="Bottom" Content="Revert all definitions" Margin="0,8,0,0" Click="OnRevertDefinitions" />
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <controls:JsonPropertyEditor x:Name="DefinitionEditor" Margin="0,0,6,0" />
              </ScrollViewer>
            </DockPanel>
          </Border>
          <TextBlock x:Name="NoDefinitionText" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Visibility="Collapsed"
                     Text="This overlay has no entry in definition.overlays." />
          <GridSplitter Grid.Column="1" />
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
              </Grid.RowDefinitions>
              <TextBlock Style="{StaticResource Section}" Text="DATA THE GAME SENDS IT" />
              <ListBox x:Name="EntryList" Grid.Row="1" SelectionChanged="OnEntryChosen" DisplayMemberPath="Label" />
              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6">
                <Button x:Name="CopyEntry" Content="Copy" Padding="12,2" Margin="0,0,4,0" Click="OnCopyEntry" />
                <Button x:Name="DeleteEntry" Content="Delete" Padding="12,2" Click="OnDeleteEntry" />
              </StackPanel>
              <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <controls:JsonPropertyEditor x:Name="EntryEditor" Margin="0,0,6,0" />
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- Files -->
        <Grid x:Name="FilesPage" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="320" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="6">
            <ListBox x:Name="FileList" BorderThickness="0" Background="Transparent" SelectionChanged="OnFileChosen">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel ToolTip="{Binding Path}">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Dim}" FontSize="11" Text="{Binding State}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <GridSplitter Grid.Column="1" />
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
            <Grid>
              <DockPanel x:Name="TextPane">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="FileRevert" Content="Revert" Padding="14,3" Margin="0,0,6,0" Click="OnFileRevert" />
                    <Button x:Name="FileSave" Content="Save" Padding="20,3" Style="{StaticResource Primary}" Click="OnFileSave" />
                  </StackPanel>
                  <TextBlock x:Name="FileProblem" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" />
                </DockPanel>
                <TextBox x:Name="FileText" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
              </DockPanel>
              <ScrollViewer x:Name="MoviePane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                  <TextBlock Style="{StaticResource Section}" Text="SCALEFORM MOVIE" />
                  <TextBlock x:Name="MovieFacts" TextWrapping="Wrap" Margin="0,0,0,10" />
                  <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,10"
                             Text="This movie's pictures are on the Textures page. To change its animation or code, export it, edit it in a Flash tool such as JPEXS, and replace it here. Studio does not read inside the animation." />
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="MovieExport" Content="Export movie" Padding="14,3" Margin="0,0,6,0" Click="OnMovieExport" />
                    <Button x:Name="MovieReplace" Content="Replace movie" Padding="14,3" Margin="0,0,6,0" Click="OnMovieReplace" />
                    <Button x:Name="MovieRevert" Content="Revert" Padding="14,3" Click="OnFileRevert" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <TextBlock x:Name="LoadingText" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Text="Reading the game's overlays..." />
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
