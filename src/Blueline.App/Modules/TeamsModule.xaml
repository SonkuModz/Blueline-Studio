<UserControl x:Class="Blueline.App.Modules.TeamsModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Blueline.App.Modules"
             xmlns:controls="clr-namespace:Blueline.App.Controls">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="*" MinWidth="420" />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="370" />
    </Grid.ColumnDefinitions>

    <!-- Teams -->
    <DockPanel>
      <ComboBox x:Name="LeagueBox" DockPanel.Dock="Top" Margin="0,0,0,6" SelectionChanged="OnFilterTeams" />
      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
        <TextBox x:Name="TeamSearch" TextChanged="OnFilterTeams" ToolTip="Find a team by name, city or abbreviation" />
        <TextBlock x:Name="TeamSearchHint" Style="{StaticResource Dim}" Text="Find a team" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
      </Grid>
      <Border Style="{StaticResource Card}" Padding="4">
        <ListBox x:Name="Teams" SelectionChanged="OnTeamChanged" VirtualizingPanel.VirtualizationMode="Standard">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="local:TeamRow">
              <Grid Loaded="OnThumbOwnerLoaded" Unloaded="OnThumbOwnerUnloaded">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="34" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="28" Height="28" Source="{Binding Thumb.Image}" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Team.Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Team.League}" FontSize="10" Foreground="{DynamicResource DimBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding EditedMark}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </DockPanel>

    <!-- The team and its art -->
    <DockPanel Grid.Column="2" Grid.ColumnSpan="3">
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image x:Name="HeaderLogo" Width="88" Height="88" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1">
            <DockPanel>
              <StackPanel x:Name="Swatches" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
              <TextBlock x:Name="TeamName" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock x:Name="TeamFacts" Style="{StaticResource Dim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TeamCounts" Style="{StaticResource Dim}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />
            <WrapPanel>
              <Button x:Name="LogoSetButton" Style="{StaticResource Primary}" Content="Replace logo set" Margin="0,0,6,4" Click="OnReplaceLogoSet"
                      ToolTip="One picture into all of this team's square logos, as one undo step" />
              <Button x:Name="ExportShownButton" Content="Export shown" Margin="0,0,6,4" Click="OnExportShown"
                      ToolTip="Saves what is shown as PNG files under their game folders, ready to edit" />
              <Button x:Name="ImportPackButton" Content="Import folder" Margin="0,0,6,4" Click="OnImportFolder"
                      ToolTip="Imports a folder of images, matching them by game path or by a file name only one texture has" />
              <Button x:Name="RevertTeamButton" Content="Revert team" Margin="0,0,6,4" Click="OnRevertTeam"
                      ToolTip="Puts back every texture of this team that this project changed" />
              <ToggleButton x:Name="GearButton" Style="{StaticResource Chip}" Content="Uniform studio" Margin="0,0,6,4" Click="OnGearColours"
                            ToolTip="The team's kits on the game's meshes, with each kit's glove and helmet colours beside them" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="420" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="370" />
        </Grid.ColumnDefinitions>
    <DockPanel x:Name="ArtPanel">
      <WrapPanel x:Name="CategoryChips" DockPanel.Dock="Top" Margin="0,0,0,6" />
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <CheckBox x:Name="EditedOnly" DockPanel.Dock="Right" Content="Edited only" FontSize="12" Margin="10,0,0,0" Click="OnGalleryOption" />
        <CheckBox x:Name="ModsOnly" DockPanel.Dock="Right" Content="Mods only" FontSize="12" Margin="10,0,0,0" Click="OnGalleryOption" Visibility="Collapsed"
                  ToolTip="Only files that come from the mods folder beside the game" />
        <CheckBox x:Name="ShowMaps" DockPanel.Dock="Right" Content="Technical maps" FontSize="12" Margin="10,0,0,0" Click="OnGalleryOption"
                  ToolTip="Also show normal, specular and similar layers" />
        <Grid>
          <TextBox x:Name="AssetSearch" TextChanged="OnAssetSearch" />
          <TextBlock x:Name="AssetSearchHint" Style="{StaticResource Dim}" Text="Filter by file name" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
      </DockPanel>
      <TextBlock x:Name="Count" DockPanel.Dock="Bottom" Style="{StaticResource Dim}" Margin="2,6,0,0" />
      <Border Style="{StaticResource Card}" Padding="6">
        <Grid>
          <ItemsControl x:Name="Gallery" SizeChanged="OnGallerySized" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Resources>
              <DataTemplate DataType="{x:Type local:GalleryHeader}">
                <TextBlock Style="{StaticResource Section}" Text="{Binding Text}" Margin="4,8,0,4" />
              </DataTemplate>
              <DataTemplate DataType="{x:Type local:GalleryRow}">
                <ItemsControl ItemsSource="{Binding Tiles}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TeamTile}">
                      <Border x:Name="Box" Width="124" Margin="2" Padding="4" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent" Background="Transparent"
                              Cursor="Hand" ToolTip="{Binding Art.Path}" Loaded="OnThumbOwnerLoaded" Unloaded="OnThumbOwnerUnloaded" MouseLeftButtonUp="OnTileClicked">
                        <StackPanel>
                          <Grid Height="108" Background="#4A5263">
                            <Image Source="{Binding Thumb.Image}" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding Thumb.Status}" FontSize="11" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding EditedMark}" Foreground="{DynamicResource AccentBrush}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,3,0" />
                          </Grid>
                          <TextBlock Text="{Binding Label}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter TargetName="Box" Property="Background" Value="{DynamicResource SelectBrush}" />
                          <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ItemsControl.Resources>
          </ItemsControl>
          <TextBlock x:Name="GalleryMessage" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="20" />
        </Grid>
      </Border>
    </DockPanel>

    <!-- The selected file -->
    <DockPanel x:Name="FilePanel" Grid.Column="2">
      <DockPanel DockPanel.Dock="Top" Margin="2,0,0,2">
        <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Content="Copy path" FontSize="12" Padding="6,0" Click="OnCopyPath" />
        <TextBlock x:Name="AssetName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock x:Name="AssetSummary" DockPanel.Dock="Top" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="2,0,0,8" />
      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <TextBlock x:Name="SharedText" Style="{StaticResource Dim}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="2,0,0,6" Visibility="Collapsed" />
        <TextBlock x:Name="BlockerText" Style="{StaticResource Dim}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="2,0,0,6" Visibility="Collapsed" />
        <CheckBox x:Name="ShowOriginal" Content="Show the original" FontSize="12" Margin="2,0,0,6" Click="OnShowOriginal" Visibility="Collapsed" />
        <WrapPanel>
          <Button x:Name="ReplaceButton" Style="{StaticResource Primary}" Content="Replace" Margin="0,0,6,4" Click="OnReplace" ToolTip="Choose an image, or drop one on the preview" />
          <Button x:Name="RevertButton" Content="Revert" Margin="0,0,6,4" Click="OnRevert" />
          <Button x:Name="ExportButton" Content="Export PNG" Margin="0,0,6,4" Click="OnExportOne" />
          <Button x:Name="EditorButton" Content="Open in editor" Margin="0,0,0,4" Click="OnEdit" />
        </WrapPanel>
        <Button x:Name="JerseyMapsButton" Content="Make normal and coeff maps" HorizontalAlignment="Left" Margin="0,0,0,4" Click="OnJerseyMaps" Visibility="Collapsed"
                ToolTip="Opens this jersey in the Jersey Maps tab, which makes its _nm and _coeff maps from this sheet" />
      </StackPanel>
      <StackPanel x:Name="ViewChoice" DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,6" Visibility="Collapsed">
        <Button x:Name="UniformChip" Style="{StaticResource Primary}" Content="Open in the uniform studio" FontSize="12" Padding="10,3" Click="OnUniformView"
                      ToolTip="Opens this kit in the uniform studio, on the game's own meshes, with its glove and helmet colours" />
      </StackPanel>
      <Border x:Name="PreviewCard" Style="{StaticResource Card}" Padding="6">
        <Grid>
          <controls:TexturePreview x:Name="Preview" />
        </Grid>
      </Border>
    </DockPanel>

    <!-- The uniform studio: the kit in 3D with the glove and helmet colours beside it -->
    <ContentControl x:Name="StudioHost" Grid.ColumnSpan="3" Visibility="Collapsed" />
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
