<UserControl x:Class="Blueline.App.Shell.StartScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Blueline.App.Controls"
             UseLayoutRounding="True">
  <UserControl.Resources>
    <!-- A button that lets its content fill the width, with a blue outline on hover -->
    <Style x:Key="CardButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              <Border x:Name="Ring" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" Opacity="0" IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.88" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid x:Name="Layer" Background="{DynamicResource WindowBrush}">
    <Image x:Name="Wallpaper" Stretch="UniformToFill" Visibility="Collapsed" />
    <Rectangle x:Name="WallpaperDim" Fill="{DynamicResource WindowBrush}" Opacity="0.74" Visibility="Collapsed" />
    <controls:RinkBackground x:Name="Rink" />

    <!-- A blue line sweeps across the window as the crest arrives -->
    <Rectangle x:Name="Sweep" Height="3" VerticalAlignment="Top" Fill="{DynamicResource AccentTextBrush}" Opacity="0"
               RenderTransformOrigin="0,0.5" IsHitTestVisible="False">
      <Rectangle.RenderTransform>
        <ScaleTransform ScaleX="0" />
      </Rectangle.RenderTransform>
    </Rectangle>

    <Grid MaxWidth="1080" Margin="48,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*" />
        <ColumnDefinition Width="56" />
        <ColumnDefinition Width="*" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <Image x:Name="Crest" Width="210" Height="210" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5"
               Source="pack://application:,,,/Assets/blueline_logo.png" RenderOptions.BitmapScalingMode="HighQuality">
          <Image.RenderTransform>
            <ScaleTransform />
          </Image.RenderTransform>
        </Image>
        <TextBlock x:Name="TitleText" HorizontalAlignment="Left" Text="Blueline Studio" FontSize="34" FontWeight="SemiBold" Margin="0,16,0,0" />
        <TextBlock x:Name="TaglineText" HorizontalAlignment="Left" Style="{StaticResource Dim}" FontSize="14" TextWrapping="Wrap" MaxWidth="440" Margin="0,6,0,0" LineHeight="21"
                   Text="Make NHL 19 your own. Your edits stay in a project, and mods install as separate archives, so the game's own files are never changed." />

        <Border x:Name="ContinueHost" Margin="0,24,0,0" Visibility="Collapsed" MaxWidth="440" HorizontalAlignment="Left">
          <Button x:Name="ContinueButton" Style="{StaticResource CardButton}" Click="OnContinue">
            <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="16,12">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource AccentTextBrush}" Text="&#xE76C;" />
                <StackPanel>
                  <TextBlock Style="{StaticResource Section}" Text="CONTINUE" />
                  <TextBlock x:Name="ContinueName" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                  <TextBlock x:Name="ContinueDetail" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </Border>
          </Button>
        </Border>

        <StackPanel x:Name="ButtonRow" Orientation="Horizontal" Margin="0,16,0,0">
          <Button x:Name="OpenButton" Content="Open project" Padding="16,7" Margin="0,0,8,0" Click="OnOpenProject" />
          <Button Content="New project" Padding="16,7" Margin="0,0,8,0" Click="OnNewProject" />
          <Button x:Name="PuckPeakButton" Content="Open Puck Peak Overtime" Padding="16,7" Margin="0,0,8,0" Click="OnPuckPeak" Visibility="Collapsed"
                  ToolTip="Make a project from the Puck Peak Overtime mod beside the game, so it can be edited and rebuilt here" />
          <Button Content="Just browse the game" Style="{StaticResource Quiet}" Padding="12,7" Click="OnBrowse" />
        </StackPanel>
      </StackPanel>

      <StackPanel x:Name="RecentHost" Grid.Column="2" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Section}" Text="RECENT PROJECTS" Margin="0,0,0,10" />
        <StackPanel x:Name="RecentList" />
        <TextBlock x:Name="NoRecent" Style="{StaticResource Dim}" TextWrapping="Wrap" Text="Projects you open or create will show up here." />
      </StackPanel>
    </Grid>

    <!-- Game status and background choice -->
    <Grid VerticalAlignment="Bottom" MaxWidth="1080" Margin="48,0,48,22" HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="GameDot" Width="8" Height="8" Fill="{DynamicResource DimBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
          <TextBlock x:Name="GameLine" Style="{StaticResource Dim}" VerticalAlignment="Center" />
          <Button x:Name="ChooseGame" Content="Choose game folder" Style="{StaticResource Quiet}" Margin="10,0,0,0" Padding="8,2" Visibility="Collapsed" Click="OnChooseGame" />
        </StackPanel>
        <ProgressBar x:Name="GameBar" Height="3" Margin="0,8,0,0" MaxWidth="440" HorizontalAlignment="Left" Width="440" Visibility="Collapsed" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
        <Button x:Name="ResetBackground" Content="Use rink artwork" Style="{StaticResource Quiet}" Padding="8,2" Visibility="Collapsed" Click="OnResetBackground" />
        <Button Content="Change background" Style="{StaticResource Quiet}" Padding="8,2" Click="OnChangeBackground" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
