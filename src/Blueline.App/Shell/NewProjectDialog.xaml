<Window x:Class="Blueline.App.Shell.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New project" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="{DynamicResource PanelBrush}">
  <StackPanel Margin="20">
    <TextBlock Style="{StaticResource Heading}" Text="New project" />
    <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,16" TextWrapping="Wrap"
               Text="A project holds your edited files and builds them into a mod. The game files stay as they are until you install." />
    <TextBlock Style="{StaticResource Section}" Text="NAME" />
    <TextBox x:Name="NameBox" TextChanged="OnNameChanged" />
    <TextBlock Style="{StaticResource Section}" Text="FOLDER" Margin="0,14,0,6" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Browse" Margin="6,0,0,0" Click="OnBrowse" />
      <TextBox x:Name="FolderBox" />
    </DockPanel>
    <TextBlock x:Name="Problem" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="Create" Style="{StaticResource Primary}" IsDefault="True" Click="OnCreate" />
    </StackPanel>
  </StackPanel>
</Window>
