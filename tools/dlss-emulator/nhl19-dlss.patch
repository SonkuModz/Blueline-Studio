diff --git a/src/video_core/host_shaders/dlss_debug.comp b/src/video_core/host_shaders/dlss_debug.comp
new file mode 100644
index 0000000..4176b4e
--- /dev/null
+++ b/src/video_core/host_shaders/dlss_debug.comp
@@ -0,0 +1,35 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(set = 0, binding = 0) uniform texture2D motion_tex;
+layout(set = 0, binding = 1) uniform texture2D depth_tex;
+layout(set = 0, binding = 2, rgba8) uniform writeonly image2D out_image;
+
+layout(push_constant) uniform Constants {
+    uint mode;
+} pc;
+
+// Mode 1: motion in pixels, red right / green down, 8 px to full; blue where zero.
+// Mode 2: depth, stretched so the ice and boards are readable.
+void main() {
+    const ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(coord, imageSize(out_image)))) {
+        return;
+    }
+    vec4 color = vec4(0.0, 0.0, 0.0, 1.0);
+    if (pc.mode == 1u) {
+        const vec2 mv = texelFetch(motion_tex, coord, 0).xy;
+        color.rg = clamp(vec2(0.5) + mv / 16.0, 0.0, 1.0);
+        color.b = dot(mv, mv) < 1e-6 ? 0.6 : 0.0;
+    } else {
+        const float d = texelFetch(depth_tex, coord, 0).x;
+        const float v = clamp(pow(clamp(d, 0.0, 1.0), 32.0), 0.0, 1.0);
+        color.rgb = vec3(v);
+    }
+    imageStore(out_image, coord, color);
+}
diff --git a/src/video_core/host_shaders/xfb_camera_common.glsl b/src/video_core/host_shaders/xfb_camera_common.glsl
new file mode 100644
index 0000000..70dc19d
--- /dev/null
+++ b/src/video_core/host_shaders/xfb_camera_common.glsl
@@ -0,0 +1,107 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Shared by the camera solve shaders. The including shader declares `double sums[]` in the
+// layout written by xfb_camera_sums.comp.
+
+const uint RegionStride = 32u;
+const uint NormalCount = 26u;
+// Static geometry measures near 1e-10; moving and skinned geometry is orders of magnitude above.
+const double InlierResidual = 1e-5LF;
+const double PivotEpsilon = 1e-12LF;
+const uint UpperStart[4] = uint[](0u, 4u, 7u, 9u);
+
+double Sum(uint region, uint slot) {
+    return sums[region * RegionStride + slot];
+}
+
+double Trace(uint region) {
+    return Sum(region, 0u) + Sum(region, 4u) + Sum(region, 7u) + Sum(region, 9u);
+}
+
+bool Usable(uint region) {
+    return Sum(region, 27u) > 0.0LF && Trace(region) > 0.0LF;
+}
+
+double Upper(uint region, uint i, uint j) {
+    const uint lo = min(i, j);
+    const uint hi = max(i, j);
+    return Sum(region, UpperStart[lo] + (hi - lo));
+}
+
+// sum |p - C c|^2 relative to sum |c|^2.
+double RelativeResidual(uint region, dvec4 c[4]) {
+    double r = Sum(region, 26u);
+    for (uint row = 0u; row < 4u; ++row) {
+        for (uint i = 0u; i < 4u; ++i) {
+            r -= 2.0LF * c[row][i] * Sum(region, 10u + row * 4u + i);
+            for (uint j = 0u; j < 4u; ++j) {
+                r += c[row][i] * Upper(region, i, j) * c[row][j];
+            }
+        }
+    }
+    return max(r, 0.0LF) / Trace(region);
+}
+
+// Unit trace per region, so dense meshes do not outweigh large surfaces.
+void Accumulate(uint region, inout double normal[NormalCount]) {
+    const double inv_trace = 1.0LF / Trace(region);
+    for (uint k = 0u; k < NormalCount; ++k) {
+        normal[k] += Sum(region, k) * inv_trace;
+    }
+}
+
+// Gauss-Jordan with partial pivoting on [A | B^T]; column r of the solution is row r of C.
+bool SolveNormal(double normal[NormalCount], out dvec4 c[4]) {
+    double m[4][8];
+    double scale = 0.0LF;
+    for (uint i = 0u; i < 4u; ++i) {
+        for (uint j = 0u; j < 4u; ++j) {
+            const uint lo = min(i, j);
+            const uint hi = max(i, j);
+            m[i][j] = normal[UpperStart[lo] + (hi - lo)];
+        }
+        for (uint r = 0u; r < 4u; ++r) {
+            m[i][4u + r] = normal[10u + r * 4u + i];
+        }
+        scale = max(scale, abs(m[i][i]));
+    }
+    for (uint r = 0u; r < 4u; ++r) {
+        c[r] = dvec4(0.0LF);
+        c[r][r] = 1.0LF;
+    }
+    if (scale <= 0.0LF) {
+        return false;
+    }
+    for (uint col = 0u; col < 4u; ++col) {
+        uint pivot = col;
+        double best = abs(m[col][col]);
+        for (uint row = col + 1u; row < 4u; ++row) {
+            if (abs(m[row][col]) > best) {
+                best = abs(m[row][col]);
+                pivot = row;
+            }
+        }
+        if (best <= PivotEpsilon * scale) {
+            return false;
+        }
+        for (uint k = 0u; k < 8u; ++k) {
+            const double t = m[col][k];
+            m[col][k] = m[pivot][k];
+            m[pivot][k] = t;
+        }
+        for (uint row = 0u; row < 4u; ++row) {
+            if (row != col) {
+                const double f = m[row][col] / m[col][col];
+                for (uint k = 0u; k < 8u; ++k) {
+                    m[row][k] -= f * m[col][k];
+                }
+            }
+        }
+    }
+    for (uint r = 0u; r < 4u; ++r) {
+        c[r] = dvec4(m[0][4u + r] / m[0][0], m[1][4u + r] / m[1][1], m[2][4u + r] / m[2][2],
+                     m[3][4u + r] / m[3][3]);
+    }
+    return true;
+}
diff --git a/src/video_core/host_shaders/xfb_camera_hypotheses.comp b/src/video_core/host_shaders/xfb_camera_hypotheses.comp
new file mode 100644
index 0000000..a9d3024
--- /dev/null
+++ b/src/video_core/host_shaders/xfb_camera_hypotheses.comp
@@ -0,0 +1,98 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#version 450
+#extension GL_GOOGLE_include_directive : require
+
+// One workgroup per hypothesis: fit C to a random sample of regions, count the regions it
+// explains. The static world is the largest set that agrees on one C.
+layout(local_size_x = 64) in;
+
+layout(set = 0, binding = 0, std430) readonly buffer Sums {
+    double sums[];
+};
+// Per hypothesis: C rows (16), inlier count, 3 unused.
+layout(set = 0, binding = 1, std430) writeonly buffer Hypotheses {
+    double hypotheses[];
+};
+
+layout(push_constant) uniform Constants {
+    uint region_count;
+} pc;
+
+#include "xfb_camera_common.glsl"
+
+const uint Threads = 64u;
+const uint SampleSize = 6u;
+const uint MaxTries = 64u;
+const uint HypothesisStride = 20u;
+
+shared dvec4 candidate[4];
+shared bool candidate_valid;
+shared uint inliers;
+
+uint Hash(uint v) {
+    const uint state = v * 747796405u + 2891336453u;
+    const uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
+    return (word >> 22u) ^ word;
+}
+
+void main() {
+    const uint hypothesis = gl_WorkGroupID.x;
+    const uint lane = gl_LocalInvocationID.x;
+
+    if (lane == 0u) {
+        uint picked[SampleSize];
+        uint count = 0u;
+        for (uint attempt = 0u; attempt < MaxTries && count < SampleSize; ++attempt) {
+            const uint region = Hash(hypothesis * MaxTries + attempt) % max(pc.region_count, 1u);
+            if (!Usable(region)) {
+                continue;
+            }
+            bool duplicate = false;
+            for (uint k = 0u; k < count; ++k) {
+                duplicate = duplicate || picked[k] == region;
+            }
+            if (!duplicate) {
+                picked[count++] = region;
+            }
+        }
+        double normal[NormalCount];
+        for (uint k = 0u; k < NormalCount; ++k) {
+            normal[k] = 0.0LF;
+        }
+        for (uint k = 0u; k < count; ++k) {
+            Accumulate(picked[k], normal);
+        }
+        dvec4 c[4];
+        const bool solved = SolveNormal(normal, c);
+        candidate_valid = count == SampleSize && solved;
+        for (uint r = 0u; r < 4u; ++r) {
+            candidate[r] = c[r];
+        }
+        inliers = 0u;
+    }
+    barrier();
+
+    if (candidate_valid) {
+        const dvec4 c[4] = dvec4[](candidate[0], candidate[1], candidate[2], candidate[3]);
+        uint local_inliers = 0u;
+        for (uint i = lane; i < pc.region_count; i += Threads) {
+            if (Usable(i) && RelativeResidual(i, c) < InlierResidual) {
+                ++local_inliers;
+            }
+        }
+        atomicAdd(inliers, local_inliers);
+    }
+    barrier();
+
+    if (lane == 0u) {
+        const uint base = hypothesis * HypothesisStride;
+        for (uint r = 0u; r < 4u; ++r) {
+            for (uint k = 0u; k < 4u; ++k) {
+                hypotheses[base + r * 4u + k] = candidate[r][k];
+            }
+        }
+        hypotheses[base + 16u] = candidate_valid ? double(inliers) : 0.0LF;
+    }
+}
diff --git a/src/video_core/host_shaders/xfb_camera_solve.comp b/src/video_core/host_shaders/xfb_camera_solve.comp
new file mode 100644
index 0000000..5e8989b
--- /dev/null
+++ b/src/video_core/host_shaders/xfb_camera_solve.comp
@@ -0,0 +1,141 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#version 450
+#extension GL_GOOGLE_include_directive : require
+
+// Takes the hypothesis with the most inliers and refits C to all of its inliers. Doubles because
+// clip z and w are nearly collinear.
+layout(local_size_x = 64) in;
+
+layout(set = 0, binding = 0, std430) readonly buffer Sums {
+    double sums[];
+};
+layout(set = 0, binding = 1, std430) readonly buffer Hypotheses {
+    double hypotheses[];
+};
+layout(set = 0, binding = 2, std430) writeonly buffer Camera {
+    vec4 clip_to_prev[4];
+    vec4 stats;
+} camera;
+
+layout(push_constant) uniform Constants {
+    uint region_count;
+    uint hypothesis_count;
+} pc;
+
+#include "xfb_camera_common.glsl"
+
+const uint Threads = 64u;
+const uint Refinements = 2u;
+const uint MinInliers = 8u;
+const uint HypothesisStride = 20u;
+
+shared double reduce_normal[Threads][NormalCount];
+shared dvec2 reduce_pair[Threads];
+shared dvec4 solution[4];
+shared bool solution_valid;
+
+void main() {
+    const uint lane = gl_LocalInvocationID.x;
+
+    // (inlier count, hypothesis index) of the best hypothesis.
+    dvec2 best = dvec2(0.0LF);
+    for (uint h = lane; h < pc.hypothesis_count; h += Threads) {
+        const double count = hypotheses[h * HypothesisStride + 16u];
+        if (count > best.x) {
+            best = dvec2(count, double(h));
+        }
+    }
+    reduce_pair[lane] = best;
+    barrier();
+    for (uint stride = Threads / 2u; stride > 0u; stride >>= 1u) {
+        if (lane < stride && reduce_pair[lane + stride].x > reduce_pair[lane].x) {
+            reduce_pair[lane] = reduce_pair[lane + stride];
+        }
+        barrier();
+    }
+    if (lane == 0u) {
+        const uint base = uint(reduce_pair[0].y) * HypothesisStride;
+        for (uint r = 0u; r < 4u; ++r) {
+            solution[r] = dvec4(hypotheses[base + r * 4u + 0u], hypotheses[base + r * 4u + 1u],
+                                hypotheses[base + r * 4u + 2u], hypotheses[base + r * 4u + 3u]);
+        }
+        solution_valid = reduce_pair[0].x >= double(MinInliers);
+    }
+    barrier();
+
+    for (uint refinement = 0u; refinement < Refinements; ++refinement) {
+        if (!solution_valid) {
+            break;
+        }
+        const dvec4 c[4] = dvec4[](solution[0], solution[1], solution[2], solution[3]);
+        double acc[NormalCount];
+        for (uint k = 0u; k < NormalCount; ++k) {
+            acc[k] = 0.0LF;
+        }
+        for (uint i = lane; i < pc.region_count; i += Threads) {
+            if (Usable(i) && RelativeResidual(i, c) < InlierResidual) {
+                Accumulate(i, acc);
+            }
+        }
+        for (uint k = 0u; k < NormalCount; ++k) {
+            reduce_normal[lane][k] = acc[k];
+        }
+        barrier();
+        for (uint stride = Threads / 2u; stride > 0u; stride >>= 1u) {
+            if (lane < stride) {
+                for (uint k = 0u; k < NormalCount; ++k) {
+                    reduce_normal[lane][k] += reduce_normal[lane + stride][k];
+                }
+            }
+            barrier();
+        }
+        if (lane == 0u) {
+            double normal[NormalCount];
+            for (uint k = 0u; k < NormalCount; ++k) {
+                normal[k] = reduce_normal[0][k];
+            }
+            dvec4 refined[4];
+            if (SolveNormal(normal, refined)) {
+                for (uint r = 0u; r < 4u; ++r) {
+                    solution[r] = refined[r];
+                }
+            }
+        }
+        barrier();
+    }
+
+    const dvec4 c[4] = dvec4[](solution[0], solution[1], solution[2], solution[3]);
+    dvec2 residual = dvec2(0.0LF);
+    if (solution_valid) {
+        for (uint i = lane; i < pc.region_count; i += Threads) {
+            if (!Usable(i)) {
+                continue;
+            }
+            const double r = RelativeResidual(i, c);
+            if (r < InlierResidual) {
+                residual += dvec2(r, 1.0LF);
+            }
+        }
+    }
+    reduce_pair[lane] = residual;
+    barrier();
+    for (uint stride = Threads / 2u; stride > 0u; stride >>= 1u) {
+        if (lane < stride) {
+            reduce_pair[lane] += reduce_pair[lane + stride];
+        }
+        barrier();
+    }
+
+    if (lane == 0u) {
+        const double inliers = reduce_pair[0].y;
+        const bool valid = solution_valid && inliers >= double(MinInliers);
+        for (uint r = 0u; r < 4u; ++r) {
+            camera.clip_to_prev[r] = vec4(solution[r]);
+        }
+        camera.stats = vec4(valid ? 1.0 : 0.0, float(inliers),
+                            float(reduce_pair[0].x / max(inliers, 1.0LF)),
+                            float(pc.region_count));
+    }
+}
diff --git a/src/video_core/host_shaders/xfb_camera_sums.comp b/src/video_core/host_shaders/xfb_camera_sums.comp
new file mode 100644
index 0000000..10ee8ea
--- /dev/null
+++ b/src/video_core/host_shaders/xfb_camera_sums.comp
@@ -0,0 +1,109 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#version 450
+
+layout(local_size_x = 64) in;
+
+// Mirrors XfbVelocityPass::RegionEntry.
+struct Region {
+    uint cur_offset;
+    uint prev_offset;
+    uint prev_max_vertices;
+    uint has_prev;
+    vec2 viewport_size;
+    vec2 viewport_offset;
+    vec2 depth_range;
+    uint blended;
+    uint negative_one_to_one;
+    uint counter_offset;
+    uint pad0;
+    uint pad1;
+    uint pad2;
+};
+
+layout(set = 0, binding = 0, std430) readonly buffer CurCapture {
+    uint cur_data[];
+};
+layout(set = 0, binding = 1, std430) readonly buffer PrevCapture {
+    uint prev_data[];
+};
+layout(set = 0, binding = 2, std430) readonly buffer Counters {
+    uint counters[];
+};
+layout(set = 0, binding = 3, std430) readonly buffer Regions {
+    Region regions[];
+};
+// Per region: sum(c c^T) upper (10), sum(p c^T) rows (16), sum(|p|^2), count, 4 unused.
+layout(set = 0, binding = 4, std430) writeonly buffer Sums {
+    double sums[];
+};
+
+const uint MaxSamples = 512u;
+const uint SumCount = 28u;
+const uint RegionStride = 32u;
+
+shared double partial[64][SumCount];
+
+void main() {
+    const uint region_index = gl_WorkGroupID.x;
+    const uint lane = gl_LocalInvocationID.x;
+    const Region region = regions[region_index];
+
+    double acc[SumCount];
+    for (uint i = 0u; i < SumCount; ++i) {
+        acc[i] = 0.0LF;
+    }
+    if (region.has_prev != 0u && region.blended == 0u) {
+        const uint count =
+            min(counters[region.counter_offset / 4u] / 20u, region.prev_max_vertices);
+        const uint step = max(1u, count / MaxSamples);
+        for (uint v = lane * step; v < count; v += 64u * step) {
+            const uint cur_base = region.cur_offset + v * 5u;
+            const uint prev_base = region.prev_offset + v * 5u;
+            if (cur_data[cur_base + 4u] != prev_data[prev_base + 4u]) {
+                continue;
+            }
+            const dvec4 c = dvec4(uintBitsToFloat(cur_data[cur_base + 0u]),
+                                  uintBitsToFloat(cur_data[cur_base + 1u]),
+                                  uintBitsToFloat(cur_data[cur_base + 2u]),
+                                  uintBitsToFloat(cur_data[cur_base + 3u]));
+            const dvec4 p = dvec4(uintBitsToFloat(prev_data[prev_base + 0u]),
+                                  uintBitsToFloat(prev_data[prev_base + 1u]),
+                                  uintBitsToFloat(prev_data[prev_base + 2u]),
+                                  uintBitsToFloat(prev_data[prev_base + 3u]));
+            if (c.w <= 0.0 || p.w <= 0.0) {
+                continue;
+            }
+            uint k = 0u;
+            for (uint i = 0u; i < 4u; ++i) {
+                for (uint j = i; j < 4u; ++j) {
+                    acc[k++] += c[i] * c[j];
+                }
+            }
+            for (uint r = 0u; r < 4u; ++r) {
+                for (uint j = 0u; j < 4u; ++j) {
+                    acc[10u + r * 4u + j] += p[r] * c[j];
+                }
+            }
+            acc[26] += dot(p, p);
+            acc[27] += 1.0LF;
+        }
+    }
+
+    for (uint i = 0u; i < SumCount; ++i) {
+        partial[lane][i] = acc[i];
+    }
+    barrier();
+    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
+        if (lane < stride) {
+            for (uint i = 0u; i < SumCount; ++i) {
+                partial[lane][i] += partial[lane + stride][i];
+            }
+        }
+        barrier();
+    }
+    if (lane < RegionStride) {
+        sums[region_index * RegionStride + lane] = lane < SumCount ? partial[0][lane] : 0.0LF;
+    }
+}
