+
+namespace {
+
+constexpr vk::Format OutputFormat = vk::Format::eR8G8B8A8Unorm;
+
+constexpr vk::ImageSubresourceRange ColorRange{
+    .aspectMask = vk::ImageAspectFlagBits::eColor,
+    .baseMipLevel = 0,
+    .levelCount = 1,
+    .baseArrayLayer = 0,
+    .layerCount = 1,
+};
+
+#ifdef SHADPS4_ENABLE_DLSS
+// Identifies this integration to NGX as a custom-engine project (no NVIDIA application ID).
+constexpr const char* NgxProjectId = "7a45e79b-1023-43e0-9e62-91eede364c5e";
+
+bool NgxOk(NVSDK_NGX_Result result) {
+    return NVSDK_NGX_SUCCEED(result);
+}
+#endif
+
+} // Anonymous namespace
+
+struct DlssPass::Impl {
+    const Instance& instance;
+    vk::Device device;
+
+    VideoCore::UniqueImage output;
+    vk::UniqueImageView storage_view;
+    vk::UniqueImageView sampled_view;
+    vk::Format sampled_format{};
+    vk::Extent2D size{};
+    bool output_initialized{};
+
+    vk::ShaderModule debug_module;
+    vk::UniqueDescriptorSetLayout debug_set_layout;
+    vk::UniquePipelineLayout debug_layout;
+    vk::UniquePipeline debug_pipeline;
+
+#ifdef SHADPS4_ENABLE_DLSS
+    bool ngx_tried{};
+    bool ngx_ready{};
+    bool disabled{};
+    NVSDK_NGX_Parameter* parameters{};
+    NVSDK_NGX_Handle* feature{};
+    vk::Extent2D feature_size{};
+    int feature_flags{};
+    u32 feature_preset{};
+    u64 frames{};
+    // GPU time of the NGX evaluate, logged every few hundred frames.
+    vk::UniqueQueryPool timer_pool;
+    double timer_sum_ms{};
+    u32 timer_samples{};
+    std::chrono::steady_clock::time_point timer_start{};
+#endif
+
+    explicit Impl(const Instance& instance_)
+        : instance{instance_}, device{instance_.GetDevice()},
+          output{instance_.GetDevice(), instance_.GetAllocator()} {
+        CreateDebugPipeline();
+    }
+
+    ~Impl() {
+#ifdef SHADPS4_ENABLE_DLSS
+        if (feature) {
+            NVSDK_NGX_VULKAN_ReleaseFeature(feature);
+        }
+        if (parameters) {
+            NVSDK_NGX_VULKAN_DestroyParameters(parameters);
+        }
+        if (ngx_ready) {
+            NVSDK_NGX_VULKAN_Shutdown1(device);
+        }
+#endif
+        if (debug_module) {
+            device.destroyShaderModule(debug_module);
+        }
+    }
+
+    void CreateDebugPipeline() {
+        debug_module = CompileSPV(DLSS_DEBUG_COMP, device);
+        ASSERT(debug_module);
+        const std::array bindings = {
+            vk::DescriptorSetLayoutBinding{
+                .binding = 0,
+                .descriptorType = vk::DescriptorType::eSampledImage,
+                .descriptorCount = 1,
+                .stageFlags = vk::ShaderStageFlagBits::eCompute,
+            },
+            vk::DescriptorSetLayoutBinding{
+                .binding = 1,
+                .descriptorType = vk::DescriptorType::eSampledImage,
+                .descriptorCount = 1,
+                .stageFlags = vk::ShaderStageFlagBits::eCompute,
+            },
+            vk::DescriptorSetLayoutBinding{
+                .binding = 2,
+                .descriptorType = vk::DescriptorType::eStorageImage,
+                .descriptorCount = 1,
+                .stageFlags = vk::ShaderStageFlagBits::eCompute,
+            },
+        };
+        debug_set_layout = Check<"create dlss debug set layout">(
+            device.createDescriptorSetLayoutUnique(vk::DescriptorSetLayoutCreateInfo{
+                .flags = vk::DescriptorSetLayoutCreateFlagBits::ePushDescriptorKHR,
+                .bindingCount = static_cast<u32>(bindings.size()),
+                .pBindings = bindings.data(),
+            }));
+        const vk::PushConstantRange push_range{
+            .stageFlags = vk::ShaderStageFlagBits::eCompute,
+            .offset = 0,
+            .size = sizeof(u32),
+        };
+        debug_layout = Check<"create dlss debug layout">(
+            device.createPipelineLayoutUnique(vk::PipelineLayoutCreateInfo{
+                .setLayoutCount = 1,
+                .pSetLayouts = &*debug_set_layout,
+                .pushConstantRangeCount = 1,
+                .pPushConstantRanges = &push_range,
+            }));
+        debug_pipeline = Check<"create dlss debug pipeline">(device.createComputePipelineUnique(
+            {}, vk::ComputePipelineCreateInfo{
+                    .stage =
+                        {
+                            .stage = vk::ShaderStageFlagBits::eCompute,
+                            .module = debug_module,
+                            .pName = "main",
+                        },
+                    .layout = *debug_layout,
+                }));
+    }
+
+    // (Re)creates the output image and its two views when the size or view format changes.
+    void EnsureOutput(vk::Extent2D extent, vk::Format view_format) {
+        if (extent == size && view_format == sampled_format && output) {
+            return;
+        }
+        // The previous output may still be read by an in-flight frame.
+        device.waitIdle();
+        sampled_view.reset();
+        storage_view.reset();
+        output.Destroy();
+
+        const vk::ImageCreateInfo image_ci{
+            .flags =
+                vk::ImageCreateFlagBits::eMutableFormat | vk::ImageCreateFlagBits::eExtendedUsage,
+            .imageType = vk::ImageType::e2D,
+            .format = OutputFormat,
+            .extent = {extent.width, extent.height, 1},
+            .mipLevels = 1,
+            .arrayLayers = 1,
+            .samples = vk::SampleCountFlagBits::e1,
+            .tiling = vk::ImageTiling::eOptimal,
+            .usage = vk::ImageUsageFlagBits::eStorage | vk::ImageUsageFlagBits::eSampled |
+                     vk::ImageUsageFlagBits::eTransferSrc | vk::ImageUsageFlagBits::eTransferDst,
+            .initialLayout = vk::ImageLayout::eUndefined,
+        };
+        output.Create(image_ci);
+        SetObjectName(device, static_cast<vk::Image>(output), "DLSS Output");
+
+        vk::ImageViewUsageCreateInfo storage_usage{
+            .usage = vk::ImageUsageFlagBits::eStorage,
+        };
+        storage_view = Check<"create dlss storage view">(device.createImageViewUnique({
+            .pNext = &storage_usage,
+            .image = output,
+            .viewType = vk::ImageViewType::e2D,
+            .format = OutputFormat,
+            .subresourceRange = ColorRange,
+        }));
+        vk::ImageViewUsageCreateInfo sampled_usage{
+            .usage = vk::ImageUsageFlagBits::eSampled,
+        };
+        sampled_view = Check<"create dlss sampled view">(device.createImageViewUnique({
+            .pNext = &sampled_usage,
+            .image = output,
+            .viewType = vk::ImageViewType::e2D,
+            .format = view_format,
+            .components = {.a = vk::ComponentSwizzle::eOne},
+            .subresourceRange = ColorRange,
+        }));
+        size = extent;
+        sampled_format = view_format;
+        output_initialized = false;
+    }
+
+    void OutputToGeneral(vk::CommandBuffer cmdbuf) {
+        const vk::ImageMemoryBarrier2 barrier{
+            .srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+            .srcAccessMask = vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite,
+            .dstStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+            .dstAccessMask = vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite,
+            .oldLayout = output_initialized ? vk::ImageLayout::eShaderReadOnlyOptimal
+                                            : vk::ImageLayout::eUndefined,
+            .newLayout = vk::ImageLayout::eGeneral,
+            .image = output,
+            .subresourceRange = ColorRange,
+        };
+        // Also makes the velocity pass writes visible to NGX.
+        const vk::MemoryBarrier2 memory{
+            .srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+            .srcAccessMask = vk::AccessFlagBits2::eMemoryWrite,
+            .dstStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+            .dstAccessMask = vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite,
+        };
+        cmdbuf.pipelineBarrier2(vk::DependencyInfo{
+            .memoryBarrierCount = 1,
+            .pMemoryBarriers = &memory,
+            .imageMemoryBarrierCount = 1,
+            .pImageMemoryBarriers = &barrier,
+        });
+    }
+
+    void OutputToSampled(vk::CommandBuffer cmdbuf) {
+        const vk::ImageMemoryBarrier2 barrier{
+            .srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+            .srcAccessMask = vk::AccessFlagBits2::eMemoryWrite,
+            .dstStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+            .dstAccessMask = vk::AccessFlagBits2::eMemoryRead,
+            .oldLayout = vk::ImageLayout::eGeneral,
+            .newLayout = vk::ImageLayout::eShaderReadOnlyOptimal,
+            .image = output,
+            .subresourceRange = ColorRange,
+        };
+        cmdbuf.pipelineBarrier2(vk::DependencyInfo{
+            .imageMemoryBarrierCount = 1,
+            .pImageMemoryBarriers = &barrier,
+        });
+        output_initialized = true;
+    }
+
+#ifdef SHADPS4_ENABLE_DLSS
+    void Fail(const char* what, NVSDK_NGX_Result result) {
+        LOG_ERROR(Render_Vulkan, "DLSS: {} failed ({:#x}); presenting without DLSS", what,
+                  static_cast<u32>(result));
+        disabled = true;
+    }
+
+    bool InitNgx() {
+        if (ngx_tried) {
+            return ngx_ready;
+        }
+        ngx_tried = true;
+        const std::wstring data_path =
+            Common::FS::GetUserPath(Common::FS::PathType::LogDir).wstring();
+        const auto gipa = VULKAN_HPP_DEFAULT_DISPATCHER.vkGetInstanceProcAddr;
+        const auto gdpa = VULKAN_HPP_DEFAULT_DISPATCHER.vkGetDeviceProcAddr;
+        NVSDK_NGX_Result result = NVSDK_NGX_VULKAN_Init_with_ProjectID(
+            NgxProjectId, NVSDK_NGX_ENGINE_TYPE_CUSTOM, "shadPS4", data_path.c_str(),
+            instance.GetInstance(), instance.GetPhysicalDevice(), device, gipa, gdpa);
+        if (!NgxOk(result)) {
+            Fail("NGX init", result);
+            return false;
+        }
+        ngx_ready = true;
+        result = NVSDK_NGX_VULKAN_GetCapabilityParameters(&parameters);
+        if (!NgxOk(result) || !parameters) {
+            Fail("NGX capability query", result);
+            return false;
+        }
+        int available = 0;
+        NVSDK_NGX_Result available_result = NVSDK_NGX_Parameter_GetI(
+            parameters, NVSDK_NGX_Parameter_SuperSampling_Available, &available);
+        if (!NgxOk(available_result) || !available) {
+            int init_result = 0;
+            NVSDK_NGX_Parameter_GetI(parameters, NVSDK_NGX_Parameter_SuperSampling_FeatureInitResult,
+                                     &init_result);
+            Fail("DLSS availability", static_cast<NVSDK_NGX_Result>(init_result));
+            return false;
+        }
+        LOG_INFO(Render_Vulkan, "DLSS: NGX ready, Super Resolution available");
+        return true;
+    }
+
+    bool EnsureFeature(vk::CommandBuffer cmdbuf, vk::Extent2D extent, int flags, u32 preset) {
+        if (feature && feature_size == extent && feature_flags == flags &&
+            feature_preset == preset) {
+            return true;
+        }
+        if (feature) {
+            device.waitIdle();
+            NVSDK_NGX_VULKAN_ReleaseFeature(feature);
+            feature = nullptr;
+        }
+        NVSDK_NGX_Parameter_SetUI(parameters, NVSDK_NGX_Parameter_DLSS_Hint_Render_Preset_DLAA,
+                                  preset);
+        NVSDK_NGX_Parameter_SetUI(parameters, NVSDK_NGX_Parameter_DLSS_Hint_Render_Preset_Quality,
+                                  preset);
+        NVSDK_NGX_DLSS_Create_Params create{};
+        create.Feature.InWidth = extent.width;
+        create.Feature.InHeight = extent.height;
+        create.Feature.InTargetWidth = extent.width;
+        create.Feature.InTargetHeight = extent.height;
+        create.Feature.InPerfQualityValue = NVSDK_NGX_PerfQuality_Value_DLAA;
+        create.InFeatureCreateFlags = flags;
+        const NVSDK_NGX_Result result = NGX_VULKAN_CREATE_DLSS_EXT1(
+            device, cmdbuf, 1, 1, &feature, parameters, &create);
+        if (!NgxOk(result) || !feature) {
+            Fail("DLSS feature create", result);
+            return false;
+        }
+        feature_size = extent;
+        feature_flags = flags;
+        feature_preset = preset;
+        LOG_INFO(Render_Vulkan, "DLSS: feature created at {}x{} (DLAA), flags {:#x}, preset {}",
+                 extent.width, extent.height, flags, preset);
+        return true;
+    }
+#endif
+};
+
+bool DlssPass::IsBuiltIn() {
+#ifdef SHADPS4_ENABLE_DLSS
+    return true;
+#else
+    return false;
+#endif
+}
+
+std::vector<const char*> DlssPass::RequiredInstanceExtensions() {
+    std::vector<const char*> out;
+#ifdef SHADPS4_ENABLE_DLSS
+    unsigned int instance_count = 0, device_count = 0;
+    const char** instance_exts = nullptr;
+    const char** device_exts = nullptr;
+    if (NgxOk(NVSDK_NGX_VULKAN_RequiredExtensions(&instance_count, &instance_exts, &device_count,
+                                                  &device_exts))) {
+        static std::vector<std::string> names;
+        names.assign(instance_exts, instance_exts + instance_count);
+        for (const auto& name : names) {
+            out.push_back(name.c_str());
+        }
+    }
+#endif
+    return out;
+}
+
+std::vector<const char*> DlssPass::RequiredDeviceExtensions() {
+    std::vector<const char*> out;
+#ifdef SHADPS4_ENABLE_DLSS
+    unsigned int instance_count = 0, device_count = 0;
+    const char** instance_exts = nullptr;
+    const char** device_exts = nullptr;
+    if (NgxOk(NVSDK_NGX_VULKAN_RequiredExtensions(&instance_count, &instance_exts, &device_count,
+                                                  &device_exts))) {
+        // Keep our own copies: NGX does not promise the strings outlive the call.
+        static std::vector<std::string> names;
+        names.assign(device_exts, device_exts + device_count);
+        for (const auto& name : names) {
+            out.push_back(name.c_str());
+        }
+    }
+#endif
+    return out;
+}
+
+DlssPass::DlssPass(const Instance& instance) : impl{std::make_unique<Impl>(instance)} {}
+
+DlssPass::~DlssPass() = default;
+
+vk::ImageView DlssPass::Render(vk::CommandBuffer cmdbuf, const Inputs& inputs,
+                               vk::Format sampled_format) {
+#ifdef SHADPS4_ENABLE_DLSS
+    auto& d = *impl;
+    if (d.disabled || !d.InitNgx()) {
+        return {};
+    }
+    if (inputs.size != inputs.velocity.size) {
+        LOG_WARNING(Render_Vulkan, "DLSS: frame {}x{} does not match depth {}x{}; skipped",
+                    inputs.size.width, inputs.size.height, inputs.velocity.size.width,
+                    inputs.velocity.size.height);
+        return {};
+    }
+    d.EnsureOutput(inputs.size, sampled_format);
+
+    int flags = NVSDK_NGX_DLSS_Feature_Flags_MVLowRes;
+    if (inputs.depth_inverted) {
+        flags |= NVSDK_NGX_DLSS_Feature_Flags_DepthInverted;
+    }
+    if (!d.EnsureFeature(cmdbuf, inputs.size, flags, inputs.preset)) {
+        return {};
+    }
+
+    d.OutputToGeneral(cmdbuf);
+
+    const auto vk_range = static_cast<VkImageSubresourceRange>(ColorRange);
+    NVSDK_NGX_Resource_VK color = NVSDK_NGX_Create_ImageView_Resource_VK(
+        inputs.color_view, inputs.color, vk_range, static_cast<VkFormat>(inputs.color_format),
+        inputs.size.width, inputs.size.height, false);
+    NVSDK_NGX_Resource_VK depth = NVSDK_NGX_Create_ImageView_Resource_VK(
+        inputs.velocity.depth_view, inputs.velocity.depth, vk_range, VK_FORMAT_R32_SFLOAT,
+        inputs.size.width, inputs.size.height, false);
+    NVSDK_NGX_Resource_VK motion = NVSDK_NGX_Create_ImageView_Resource_VK(
+        inputs.velocity.motion_view, inputs.velocity.motion, vk_range, VK_FORMAT_R16G16_SFLOAT,
+        inputs.size.width, inputs.size.height, false);
+    NVSDK_NGX_Resource_VK out = NVSDK_NGX_Create_ImageView_Resource_VK(
+        *d.storage_view, static_cast<vk::Image>(d.output), vk_range,
+        static_cast<VkFormat>(OutputFormat), inputs.size.width, inputs.size.height, true);
+
+    NVSDK_NGX_VK_DLSS_Eval_Params eval{};
+    eval.Feature.pInColor = &color;
+    eval.Feature.pInOutput = &out;
+    eval.pInDepth = &depth;
+    eval.pInMotionVectors = &motion;
+    eval.InJitterOffsetX = inputs.jitter_x;
+    eval.InJitterOffsetY = inputs.jitter_y;
+    eval.InRenderSubrectDimensions = {inputs.size.width, inputs.size.height};
+    eval.InReset = inputs.reset ? 1 : 0;
+    // The velocity pass writes pixels, previous minus current, which is NGX's convention.
+    eval.InMVScaleX = 1.0f;
+    eval.InMVScaleY = 1.0f;
+    eval.InPreExposure = 1.0f;
+    eval.InExposureScale = 1.0f;
+
+    if (!d.timer_pool) {
+        auto [pool_result, pool] = d.device.createQueryPoolUnique(vk::QueryPoolCreateInfo{
+            .queryType = vk::QueryType::eTimestamp,
+            .queryCount = 8,
+        });
+        if (pool_result == vk::Result::eSuccess) {
+            d.timer_pool = std::move(pool);
+        }
+    }
+    const u32 timer_slot = static_cast<u32>(d.frames % 4) * 2;
+    if (d.timer_pool) {
+        if (d.frames >= 4) {
+            std::array<u64, 2> stamps{};
+            const auto read = d.device.getQueryPoolResults(
+                *d.timer_pool, timer_slot, 2, sizeof(stamps), stamps.data(), sizeof(u64),
+                vk::QueryResultFlagBits::e64);
+            if (read == vk::Result::eSuccess && stamps[1] > stamps[0]) {
+                const double period = d.instance.GetPhysicalDevice()
+                                          .getProperties()
+                                          .limits.timestampPeriod;
+                d.timer_sum_ms += double(stamps[1] - stamps[0]) * period / 1e6;
+                if (d.timer_samples == 0) {
+                    d.timer_start = std::chrono::steady_clock::now();
+                }
+                if (++d.timer_samples == 600) {
+                    const double secs = std::chrono::duration<double>(
+                                            std::chrono::steady_clock::now() - d.timer_start)
+                                            .count();
+                    LOG_INFO(Render_Vulkan,
+                             "DLSS: evaluate takes {:.3f} ms on the GPU (avg of {}), {:.1f} fps",
+                             d.timer_sum_ms / d.timer_samples, d.timer_samples,
+                             secs > 0.0 ? (d.timer_samples - 1) / secs : 0.0);
+                    d.timer_sum_ms = 0.0;
+                    d.timer_samples = 0;
+                }
+            }
+        }
+        cmdbuf.resetQueryPool(*d.timer_pool, timer_slot, 2);
+        cmdbuf.writeTimestamp(vk::PipelineStageFlagBits::eAllCommands, *d.timer_pool, timer_slot);
+    }
+    const NVSDK_NGX_Result result =
+        NGX_VULKAN_EVALUATE_DLSS_EXT(cmdbuf, d.feature, d.parameters, &eval);
+    if (d.timer_pool) {
+        cmdbuf.writeTimestamp(vk::PipelineStageFlagBits::eAllCommands, *d.timer_pool,
+                              timer_slot + 1);
+    }
+    if (!NgxOk(result)) {
+        d.Fail("DLSS evaluate", result);
+        // Leave the image in a known layout for the next frame's barrier.
+        d.OutputToSampled(cmdbuf);
+        return {};
+    }
+    d.OutputToSampled(cmdbuf);
+    if (d.frames++ == 0) {
+        LOG_INFO(Render_Vulkan, "DLSS: first frame evaluated at {}x{}", inputs.size.width,
+                 inputs.size.height);
+    }
+    return *d.sampled_view;
+#else
+    (void)cmdbuf;
+    (void)inputs;
+    (void)sampled_format;
+    return {};
+#endif
+}
+
+vk::ImageView DlssPass::RenderDebug(vk::CommandBuffer cmdbuf,
+                                    const XfbVelocityPass::Outputs& velocity, u32 mode,
+                                    vk::Extent2D size, vk::Format sampled_format) {
+    auto& d = *impl;
+    d.EnsureOutput(size, sampled_format);
+    d.OutputToGeneral(cmdbuf);
+
+    const std::array image_infos = {
+        vk::DescriptorImageInfo{
+            .imageView = velocity.motion_view,
+            .imageLayout = vk::ImageLayout::eGeneral,
+        },
+        vk::DescriptorImageInfo{
+            .imageView = velocity.depth_view,
+            .imageLayout = vk::ImageLayout::eGeneral,
+        },
+        vk::DescriptorImageInfo{
+            .imageView = *d.storage_view,
+            .imageLayout = vk::ImageLayout::eGeneral,
+        },
+    };
+    const std::array writes = {
+        vk::WriteDescriptorSet{
+            .dstBinding = 0,
+            .descriptorCount = 1,
+            .descriptorType = vk::DescriptorType::eSampledImage,
+            .pImageInfo = &image_infos[0],
+        },
+        vk::WriteDescriptorSet{
+            .dstBinding = 1,
+            .descriptorCount = 1,
+            .descriptorType = vk::DescriptorType::eSampledImage,
+            .pImageInfo = &image_infos[1],
+        },
+        vk::WriteDescriptorSet{
+            .dstBinding = 2,
+            .descriptorCount = 1,
+            .descriptorType = vk::DescriptorType::eStorageImage,
+            .pImageInfo = &image_infos[2],
+        },
+    };
+    cmdbuf.bindPipeline(vk::PipelineBindPoint::eCompute, *d.debug_pipeline);
+    cmdbuf.pushDescriptorSetKHR(vk::PipelineBindPoint::eCompute, *d.debug_layout, 0, writes);
+    cmdbuf.pushConstants(*d.debug_layout, vk::ShaderStageFlagBits::eCompute, 0, sizeof(u32),
+                         &mode);
+    cmdbuf.dispatch((size.width + 7) / 8, (size.height + 7) / 8, 1);
+    d.OutputToSampled(cmdbuf);
+    return *d.sampled_view;
+}
+
