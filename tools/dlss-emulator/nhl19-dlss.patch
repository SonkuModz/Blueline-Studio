+vk::ImageView Rasterizer::EvaluateDlss(VideoCore::Image& color, vk::Format view_format) {
+    if (!dlss || !xfb_velocity) {
+        return {};
+    }
+    const auto outputs = xfb_velocity->FrameOutputs();
+    if (!outputs) {
+        return {};
+    }
+    const bool srgb =
+        view_format == vk::Format::eB8G8R8A8Srgb || view_format == vk::Format::eR8G8B8A8Srgb;
+    const bool unorm8 =
+        view_format == vk::Format::eB8G8R8A8Unorm || view_format == vk::Format::eR8G8B8A8Unorm;
+    if (!srgb && !unorm8) {
+        // 10-bit and HDR frames are left alone.
+        return {};
+    }
+    const vk::Format sampled_format =
+        srgb ? vk::Format::eR8G8B8A8Srgb : vk::Format::eR8G8B8A8Unorm;
+    const vk::Extent2D size{color.info.size.width, color.info.size.height};
+
+    scheduler.EndRendering();
+    const auto cmdbuf = scheduler.CommandBuffer();
+    if (const u32 mode = EmulatorSettings.GetDlssDebugView(); mode != 0) {
+        if (outputs->size != size) {
+            return {};
+        }
+        return dlss->RenderDebug(cmdbuf, *outputs, mode, size, sampled_format);
+    }
+    if (!EmulatorSettings.IsDlssEnabled()) {
+        return {};
+    }
+
+    VideoCore::ImageViewInfo unorm_info{};
+    unorm_info.format = view_format == vk::Format::eB8G8R8A8Srgb   ? vk::Format::eB8G8R8A8Unorm
+                        : view_format == vk::Format::eR8G8B8A8Srgb ? vk::Format::eR8G8B8A8Unorm
+                                                                   : view_format;
+    const auto color_view = *color.FindView(unorm_info).image_view;
+
+    if (size != dlss_last_size) {
+        dlss_reset = true;
+        dlss_last_size = size;
+    }
+    const float sign = EmulatorSettings.IsDlssJitterFlip() ? -1.0f : 1.0f;
+    const HostPasses::DlssPass::Inputs inputs{
+        .color = color.GetImage(),
+        .color_view = color_view,
+        .color_format = unorm_info.format,
+        .size = size,
+        .velocity = *outputs,
+        .jitter_x = jitter_enabled ? sign * presented_jitter_x : 0.0f,
+        .jitter_y = jitter_enabled ? sign * presented_jitter_y : 0.0f,
+        .reset = dlss_reset,
+        .depth_inverted = depth_inverted,
+        .preset = EmulatorSettings.GetDlssPreset(),
+    };
+    const auto view = dlss->Render(cmdbuf, inputs, sampled_format);
+    if (view) {
+        dlss_reset = false;
+    }
+    return view;
+}
