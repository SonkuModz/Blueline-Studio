+bool Rasterizer::ShouldJitterDraw(const RenderState& state) {
+    const auto& regs = liverpool->regs;
+    if (regs.IsClipDisabled() || !state.depth_stencil_attachment.has_depth || !db_desc.image_id) {
+        return false;
+    }
+    // Scene geometry depth-tests; fullscreen post passes (even stencil-masked ones) do not.
+    if (!regs.depth_control.depth_enable || !regs.depth_buffer.DepthValid()) {
+        return false;
+    }
+    const auto& depth_image = texture_cache.GetImage(db_desc.image_id);
+    const u32 width = depth_image.info.size.width;
+    const u32 height = depth_image.info.size.height;
+    if (!VideoCore::XfbMatchesAspect(width, height, xfb_output_extent)) {
+        return false;
+    }
+    // Excludes half and quarter size targets (reflections, bloom, depth of field).
+    if (u64(width) * height * 10 < u64(xfb_output_extent.width) * xfb_output_extent.height * 6) {
+        return false;
+    }
+    if (regs.depth_control.depth_write_enable) {
+        using AmdGpu::CompareFunc;
+        const auto func = regs.depth_control.depth_func;
+        if (func == CompareFunc::Greater || func == CompareFunc::GreaterEqual) {
+            ++depth_greater_draws;
+        } else if (func == CompareFunc::Less || func == CompareFunc::LessEqual) {
+            ++depth_less_draws;
+        }
+    }
+    return true;
+}
