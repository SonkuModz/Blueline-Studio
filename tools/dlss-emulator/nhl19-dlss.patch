+void Rasterizer::EndXfbFrame(vk::Extent2D output_extent) {
+    if (!xfb_capture) {
+        return;
+    }
+    scheduler.EndRendering();
+    if (xfb_velocity) {
+        xfb_velocity->Render(*xfb_capture, output_extent);
+    }
+    xfb_capture->EndFrame(scheduler.CommandBuffer());
+    xfb_output_extent = output_extent;
+
+    // The frame just closed was drawn with the current jitter; the next one gets a new phase.
+    presented_jitter_x = jitter_x;
+    presented_jitter_y = jitter_y;
+    if (depth_greater_draws + depth_less_draws > 0) {
+        depth_inverted = depth_greater_draws > depth_less_draws;
+    }
+    depth_greater_draws = 0;
+    depth_less_draws = 0;
+    if (jitter_enabled) {
+        // Halton (2, 3), 16 phases, centred on the pixel.
+        jitter_index = (jitter_index + 1) % 16;
+        jitter_x = Halton(jitter_index + 1, 2) - 0.5f;
+        jitter_y = Halton(jitter_index + 1, 3) - 0.5f;
+    }
+}
