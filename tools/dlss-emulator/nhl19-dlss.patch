+
+// NVIDIA DLSS Super Resolution (DLAA when input and output sizes match) through the public NGX
+// SDK, run on the presented guest frame. Depth and motion vectors come from XfbVelocityPass; the
+// sub-pixel jitter is applied by the rasterizer to scene draws. Built only when the NGX SDK is
+// configured (SHADPS4_ENABLE_DLSS); otherwise every call is a no-op.
+class DlssPass {
+public:
+    // Whether this build contains the NGX integration.
+    static bool IsBuiltIn();
+
+    // Extensions NGX asks for. Queried before the instance and device exist.
+    static std::vector<const char*> RequiredInstanceExtensions();
+    static std::vector<const char*> RequiredDeviceExtensions();
+
+    explicit DlssPass(const Instance& instance);
+    ~DlssPass();
+
+    struct Inputs {
+        vk::Image color;
+        // Non-sRGB view of the colour, so DLSS sees the display-encoded values.
+        vk::ImageView color_view;
+        vk::Format color_format;
+        vk::Extent2D size;
+        XfbVelocityPass::Outputs velocity;
+        float jitter_x;
+        float jitter_y;
+        bool reset;
+        bool depth_inverted;
+        u32 preset;
+    };
+
+    // Evaluates DLSS into an internal image of the same size and returns a sampled view of it in
+    // `sampled_format` (sRGB or not, matching the guest view). Returns null when DLSS is not
+    // available or the inputs do not line up; the caller then presents the original frame.
+    vk::ImageView Render(vk::CommandBuffer cmdbuf, const Inputs& inputs,
+                         vk::Format sampled_format);
+
+    // Replaces the frame with a visualisation: 1 motion vectors, 2 depth.
+    vk::ImageView RenderDebug(vk::CommandBuffer cmdbuf, const XfbVelocityPass::Outputs& velocity,
+                              u32 mode, vk::Extent2D size, vk::Format sampled_format);
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl;
+};
+
+} // namespace Vulkan::HostPasses
