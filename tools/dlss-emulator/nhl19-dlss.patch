+float Halton(u32 index, u32 base) {
+    float f = 1.0f;
+    float result = 0.0f;
+    for (u32 i = index; i > 0; i /= base) {
+        f /= static_cast<float>(base);
+        result += f * static_cast<float>(i % base);
+    }
+    return result;
+}
